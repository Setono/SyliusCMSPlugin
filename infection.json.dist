{
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "Command",
            "Controller",
            "Repository",
            "Resources",
            "Rendering/EntryUrlLookup.php",
            "Query/VisibleEntriesQuery.php"
        ]
    },
    "testFrameworkOptions": "--testsuite=unit",
    "logs": {
        "text": "php://stderr",
        "github": true,
        "stryker": {
            "badge": "2.x"
        }
    },
    "minMsi": 100.00,
    "minCoveredMsi": 100.00
}
