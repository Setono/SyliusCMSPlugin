{# Each taxon as a tile leading to its product listing, at the URL its link target gives (cms_url()), with its first image through Sylius's images. A taxon without a translation in the locale has no URL there, and no tile #}
{% set taxons = cms_value(block, 'taxons') %}
{% if taxons is not null and taxons|length > 0 %}
    <div class="cms-taxons{{ view.styleClass ? ' ' ~ view.styleClass }}">
        {%- for taxon in taxons %}
            {%- set url = cms_url(taxon) %}
            {%- if url is not null %}
            {% set image = taxon.images.first %}
            <a class="cms-taxons__item" href="{{ url }}">
                {%- if image -%}
                    <img class="cms-taxons__image" src="{{ image.path|imagine_filter('sylius_shop_product_thumbnail') }}" alt="" loading="lazy">
                {%- endif -%}
                <span class="cms-taxons__name">{{ taxon.name }}</span>
            </a>
            {%- endif %}
        {%- endfor %}
    </div>
{% endif %}
