{# The listed entries, each through its own content type's card for the display (cms_card()), each card in a
   cms-entries__item: a grid, a carousel of 3 per view, or one after another, such as an accordion of FAQ items. An entry
   whose content type has no card for the display is left out, and without a card to show, the block prints nothing.
   See "The Entries block" in docs/spec/collections.md #}
{%- set entries = cms_value(block, 'entries') -%}
{%- set cards = [] -%}
{%- for entry in entries ?? [] -%}
    {%- set card -%}{{ cms_card(entry, block.display) }}{%- endset -%}
    {%- if card is not empty -%}
        {%- set cards = cards|merge([card]) -%}
    {%- endif -%}
{%- endfor -%}
{% if cards is not empty %}
    <div class="cms-entries cms-entries--{{ block.display }}{{ view.styleClass ? ' ' ~ view.styleClass }}">
        {%- if block.display == 'carousel' %}
            {#- The Carousel block's markup around the cards, showing 3 at once on wide screens -#}
            {%- import '@SetonoSyliusCMSPlugin/block/_carousel.html.twig' as markup -%}
            {%- set slides = [] -%}
            {%- for card in cards -%}
                {%- set slide -%}<div class="cms-entries__item">{{ card }}</div>{%- endset -%}
                {%- set slides = slides|merge([slide]) -%}
            {%- endfor %}
            {{ markup.carousel(slides, 3) }}
        {%- else %}
            {%- for card in cards %}
                <div class="cms-entries__item">{{ card }}</div>
            {%- endfor %}
        {%- endif %}
    </div>
{% endif %}
