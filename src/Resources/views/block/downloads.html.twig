{# A link to each document's permanent URL, which follows a replace, named by the document's name. The block renders nothing
   without a document. The heading is left out when cms_field() prints nothing for it; in the builder's preview it prints an
   empty field's markers, so editors can type it in place #}
{% set documents = cms_value(block, 'documents') %}
{% if documents is not null and documents|length > 0 %}
    <div class="cms-downloads{{ view.styleClass ? ' ' ~ view.styleClass }}">
        {%- set heading -%}{{ cms_field(block, 'heading') }}{%- endset -%}
        {%- if heading is not empty %}
        <h2 class="cms-downloads__heading">{{ heading }}</h2>
        {%- endif %}
        <ul class="cms-downloads__items">
            {%- for document in documents %}
            <li><a class="cms-downloads__item" href="{{ cms_media_url(document) }}">{{ document.name }}</a></li>
            {%- endfor %}
        </ul>
    </div>
{% endif %}
