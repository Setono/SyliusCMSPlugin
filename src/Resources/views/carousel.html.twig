{% block carousel %}
    <div class="sscms-carousel {{ identifier }}">
        <div class="items">
            {% for item in items %}
                {{ block('item') }}
            {% endfor %}
        </div>

        {% if configuration.showControls %}
            {{ block('navigation') }}
        {% endif %}
        {{ block('script') }}
    </div>
{% endblock %}

{% block item %}
    <div class="item">
        {{ sscms_block(item) }}
    </div>
{% endblock %}

{% block navigation %}
    <div class="navigation">
        <button class="left ui huge black icon button">
            <i class="left arrow icon"></i>
        </button>
        <button class="right ui huge black icon button">
            <i class="right arrow icon"></i>
        </button>
    </div>
{% endblock %}

{% block script %}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <script>
        $(document).ready(() => {
            $('.{{ identifier }} .items').slick({
                infinite: {{ configuration.infinite ? 'true' : 'false' }},
                slidesToShow: {{ configuration.slidesToShow }},
                slidesToScroll: {{ configuration.slidesToScroll }},
                prevArrow: $('.{{ identifier }} button.left'),
                nextArrow: $('.{{ identifier }} button.right'),
                appendArrows: false,
                autoplay: {{ configuration.autoplay ? 'true' : 'false' }},
                autoplaySpeed: {{ configuration.autoplaySpeed }},
            });
        });
    </script>
{% endblock %}
