{{ form_errors(form) }}
<div class="ui two column stackable grid">
    <div class="column">
        <div class="ui segment">
            {{ form_row(form.code) }}
            {{ form_row(form.source) }}
            {{ form_row(form.internalDescription) }}
        </div>
    </div>
    <div class="column">
        <div class="ui segment">
            <h4 class="ui medium header">How templates work</h4>
            <p>Templates are written in the template language <a href="https://twig.symfony.com/doc/2.x/templates.html" target="_blank">Twig</a>. You can read about the advantages of that in the <a href="https://docs.sylius-cms.com/concepts/templates" target="_blank">docs</a>.</p>
        </div>
    </div>
    <div class="sixteen wide column">
        <h4 class="ui top attached large header">{{ form.source.vars.label|trans }}</h4>
        <div class="ui attached segment">
            <iframe src="{{ url('setono_sylius_cms_admin_template_editor', {'id': resource.id, 'formElement': form.source.vars.id}) }}" style="width: 100%; height: 600px; border: 0; overflow: hidden" allow="fullscreen" scrolling="no"></iframe>
        </div>
    </div>
</div>
