{#
 # The Overview's Needs attention, a block of setono_sylius_cms.admin.overview.panels: the errors and warnings across
 # the store, grouped by kind, the groups of errors first. Each problem names its entry, which links to the entry's
 # overview page, and links to where it's fixed. A kind is named by setono_sylius_cms.problem_kind.<code>, or else by
 # its code. Below them it flags the images missing alt text, which aren't problems, with a link to the media library
 # filtered by missing alt text. See "Overview" and "Problems" in docs/spec/admin.md and "Metadata" in docs/spec/media.md
 #}
{% set needs_attention = cms_admin_needs_attention() %}
{% set missing_alt_text = cms_admin_missing_alt_text() %}
{% set preset_problems = cms_admin_preset_problems() %}
<div class="column">
    <section class="ui segment" data-panel="needs_attention" aria-labelledby="cms-panel-needs-attention">
        <h2 class="ui dividing header" id="cms-panel-needs-attention">{{ 'setono_sylius_cms.ui.status_filter.needs_attention'|trans }}</h2>

        {% if needs_attention.groups is empty and preset_problems is empty and missing_alt_text == 0 %}
            <p>{{ 'setono_sylius_cms.ui.nothing_needs_attention'|trans }}</p>
        {% endif %}

        {% for group in needs_attention.groups %}
            {% set error = group.severity.value == 'error' %}
            {% set kind_label = 'setono_sylius_cms.problem_kind.' ~ group.kind %}
            <div class="cms-problem-group" data-problem-kind="{{ group.kind }}" data-severity="{{ group.severity.value }}">
                <h3 class="ui small header">
                    <i class="{{ error ? 'red times circle' : 'orange exclamation triangle' }} icon" aria-hidden="true"></i>
                    <div class="content">
                        {{ kind_label|trans != kind_label ? kind_label|trans : group.kind }}
                        <span class="ui {{ error ? 'red' : 'orange' }} circular mini label">{{ group.problems|length }}</span>
                    </div>
                </h3>

                <div class="ui divided relaxed list">
                    {% for problem in group.problems %}
                        {% set row = cms_admin_entry_row(problem.entry) %}
                        <div class="item" data-entry="{{ problem.entry.uuid }}"{% if problem.block is not null %} data-block="{{ problem.block }}"{% endif %}>
                            {% if problem.fix is not null %}
                                <div class="right floated content">
                                    <a class="ui mini labeled icon button" href="{{ path(problem.fix.route, problem.fix.parameters) }}">
                                        <i class="wrench icon"></i> {{ problem.fix.label|trans }}
                                    </a>
                                </div>
                            {% endif %}
                            <div class="content">
                                <a class="header" href="{{ path('setono_sylius_cms_admin_entry_show', {'uuid': problem.entry.uuid}) }}">{{ row.title|default('setono_sylius_cms.ui.untitled'|trans) }}</a>
                                <div class="description">{{ problem.message|trans }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}

        {# Presets aren't entries, so their problems are listed by the preset's name, a code preset marked as coming from code #}
        {% for group in preset_problems %}
            {% set error = group.severity.value == 'error' %}
            {% set kind_label = 'setono_sylius_cms.problem_kind.' ~ group.kind %}
            <div class="cms-problem-group" data-problem-kind="{{ group.kind }}" data-severity="{{ group.severity.value }}">
                <h3 class="ui small header">
                    <i class="{{ error ? 'red times circle' : 'orange exclamation triangle' }} icon" aria-hidden="true"></i>
                    <div class="content">
                        {{ kind_label|trans != kind_label ? kind_label|trans : group.kind }}
                        <span class="ui {{ error ? 'red' : 'orange' }} circular mini label">{{ group.problems|length }}</span>
                    </div>
                </h3>

                <div class="ui divided relaxed list">
                    {% for problem in group.problems %}
                        {% set name = problem.preset.name %}
                        <div class="item" data-preset="{{ problem.preset.id }}">
                            {% if problem.fix is not null %}
                                <div class="right floated content">
                                    <a class="ui mini labeled icon button" href="{{ path(problem.fix.route, problem.fix.parameters) }}">
                                        <i class="wrench icon"></i> {{ problem.fix.label|trans }}
                                    </a>
                                </div>
                            {% endif %}
                            <div class="content">
                                <div class="header">
                                    {{- name.key is defined ? name|trans : name -}}
                                    {% if problem.preset.fromCode %} <span class="ui mini basic label">{{ 'setono_sylius_cms.ui.from_code'|trans }}</span>{% endif %}
                                </div>
                                <div class="description">{{ problem.message|trans }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}

        {% if needs_attention.total > 0 %}
            <a href="{{ path('setono_sylius_cms_admin_entry_index_all', {'criteria': {'status': 'needs_attention'}}) }}">{{ 'setono_sylius_cms.ui.all_needing_attention'|trans({'%count%': needs_attention.total}) }}</a>
        {% endif %}

        {% if missing_alt_text > 0 %}
            <div class="ui divider"></div>
            <div class="cms-flag" data-flag="missing_alt_text">
                <i class="blue flag icon" aria-hidden="true"></i>
                <a href="{{ path('setono_sylius_cms_admin_media_index', {'missingAlt': 1}) }}">{{ 'setono_sylius_cms.ui.missing_alt_text'|trans({'%count%': missing_alt_text}) }}</a>
            </div>
        {% endif %}
    </section>
</div>
