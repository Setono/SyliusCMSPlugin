{#
 # The Content hub: the Sylius admin layout with the hub's own side menu beside each page, and the hub's own stylesheet
 # and script, which runs the create dialog. Pages of the hub extend it and fill the hub_content block.
 # See "Navigation" in docs/spec/admin.md
 #}
{% extends '@SyliusAdmin/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/setonosyliuscmsplugin/admin/admin.css') }}">
{% endblock %}

{% block content %}
    <div class="ui stackable grid">
        <div class="three wide column">
            {{ knp_menu_render('setono_sylius_cms.admin.hub', {'template': '@SetonoSyliusCMSPlugin/admin/menu/hub.html.twig', 'currentClass': 'active'}) }}
        </div>
        <div class="thirteen wide column">
            {% block hub_content %}{% endblock %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('bundles/setonosyliuscmsplugin/admin/create-entry-dialog.js') }}"></script>
{% endblock %}
