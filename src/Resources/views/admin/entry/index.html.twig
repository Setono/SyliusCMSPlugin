{#
 # The entry lists in the hub: the grids of the entry resource, rendered by its resource controller, so `resources` is
 # the grid view. All entries' route has no content type, and a content type's list has its code in the route.
 # See "Entry lists" in docs/spec/admin.md
 #}
{% extends '@SetonoSyliusCMSPlugin/admin/layout.html.twig' %}

{% import '@SyliusUi/Macro/headers.html.twig' as headers %}
{% import '@SyliusAdmin/Macro/breadcrumb.html.twig' as breadcrumb %}

{% set definition = resources.definition %}
{% set content_type_code = app.request.attributes.get('contentType') %}
{# Editors drag the entries of a content type ordered by position into order in its list, which saves it at once #}
{% set ordered_by_position = content_type_code is not null and cms_admin_content_type(content_type_code).order.byPosition %}

{% if content_type_code is null %}
    {% set heading = 'setono_sylius_cms.ui.all_entries'|trans %}
{% else %}
    {# A content type's list is named by its plural, setono_sylius_cms.content_type_plural.<code>, or else by its label #}
    {% set plural = 'setono_sylius_cms.content_type_plural.' ~ content_type_code %}
    {% set heading = plural|trans != plural ? plural|trans : cms_admin_content_type(content_type_code).label|trans %}
{% endif %}

{% block title %}{{ heading }} {{ parent() }}{% endblock %}

{% block hub_content %}
    <div class="ui stackable two column grid">
        <div class="column">
            {{ headers.default(heading, content_type_code is null ? 'list' : 'file alternate outline') }}

            {{ breadcrumb.crumble([
                { label: 'sylius.ui.administration'|trans, url: path('sylius_admin_dashboard') },
                { label: 'setono_sylius_cms.ui.content'|trans, url: path('setono_sylius_cms_admin_overview') },
                { label: heading },
            ]) }}
        </div>
        <div class="middle aligned column">
            <div class="ui right floated buttons">
                {% if definition.actionGroups.main is defined %}
                    {% for action in definition.getEnabledActions('main') %}
                        {{ sylius_grid_render_action(resources, action, null) }}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>

    {% if ordered_by_position %}
        <div class="ui info message cms-entry-order"
             data-cms-entry-order
             data-url="{{ path('setono_sylius_cms_admin_entry_order', {'contentType': content_type_code}) }}"
             data-csrf-token="{{ csrf_token('setono_sylius_cms_entry_order') }}"
             data-move-up="{{ 'setono_sylius_cms.ui.move_up'|trans }}"
             data-move-down="{{ 'setono_sylius_cms.ui.move_down'|trans }}"
             data-saving="{{ 'setono_sylius_cms.ui.order_saving'|trans }}"
             data-saved="{{ 'setono_sylius_cms.ui.order_saved'|trans }}"
             data-failed="{{ 'setono_sylius_cms.ui.order_not_saved'|trans }}">
            <p>{{ 'setono_sylius_cms.ui.drag_to_order'|trans }}</p>
            <p class="cms-entry-order__status" role="status" aria-live="polite" data-cms-entry-order-status></p>
        </div>
    {% endif %}

    {{ sylius_grid_render(resources, '@SyliusAdmin/Grid/_default.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if ordered_by_position %}
        <script type="module" src="{{ asset('bundles/setonosyliuscmsplugin/admin/entry-order.js') }}"></script>
    {% endif %}
{% endblock %}
