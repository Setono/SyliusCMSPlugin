{#
 # The overview page's URLs section, a block of setono_sylius_cms.admin.entry.show.sections, for a content type with
 # its own URL: the URL per locale, the one the draft gives it once published, when that's another, and the old slugs
 # that redirect to it. For a page, "Homepage of" per channel, with the page that's each channel's homepage now.
 # See "Entry overview page" in docs/spec/admin.md
 #}
{% if row.contentType.hasOwnUrl() %}
    {% set urls = cms_admin_entry_urls(entry) %}
    {% set homepages = cms_admin_channel_homepages(entry) %}
    <section class="ui segment" data-section="urls" aria-labelledby="cms-section-urls">
        <h2 class="ui dividing header" id="cms-section-urls">{{ 'setono_sylius_cms.ui.urls'|trans }}</h2>

        {% if urls is empty %}
            <p>{{ 'setono_sylius_cms.ui.no_urls'|trans }}</p>
        {% else %}
            <table class="ui very basic table">
                <thead>
                    <tr>
                        <th>{{ 'setono_sylius_cms.ui.language'|trans }}</th>
                        <th>{{ 'setono_sylius_cms.ui.url'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for url in urls %}
                        <tr data-locale="{{ url.localeCode }}">
                            <td data-locale-name>{{ url.localeCode|sylius_locale_name }}</td>
                            <td>
                                {% if url.url is not null %}
                                    <code data-url>{{ url.url }}</code>
                                {% endif %}
                                {% if url.draftUrl is not null %}
                                    <div data-draft-url><small>{{ 'setono_sylius_cms.ui.url_after_publishing'|trans({'%url%': url.draftUrl}) }}</small></div>
                                {% endif %}
                                {% if url.oldUrls is not empty %}
                                    <div data-old-urls>
                                        <small>{{ 'setono_sylius_cms.ui.old_urls'|trans }}</small>
                                        {% for oldUrl in url.oldUrls %}
                                            <code data-old-url>{{ oldUrl }}</code>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if homepages is not empty %}
            <h3 class="ui header" id="cms-homepage-of">{{ 'setono_sylius_cms.ui.homepage_of'|trans }}</h3>
            <p>{{ 'setono_sylius_cms.ui.homepage_of_help'|trans }}</p>
            <table class="ui very basic table" aria-labelledby="cms-homepage-of" data-homepages>
                <thead>
                    <tr>
                        <th>{{ 'setono_sylius_cms.ui.channel'|trans }}</th>
                        <th>{{ 'setono_sylius_cms.ui.homepage_now'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for homepage in homepages %}
                        <tr data-channel="{{ homepage.channelCode }}"{% if homepage.ofThisPage %} class="positive" data-homepage-of{% endif %}>
                            <td data-channel-name>{{ homepage.channelName }}</td>
                            <td data-homepage>
                                {% if homepage.homepage is null %}
                                    {{ 'setono_sylius_cms.ui.store_homepage'|trans }}
                                {% elseif homepage.ofThisPage %}
                                    <strong>{{ 'setono_sylius_cms.ui.this_page'|trans }}</strong>
                                {% else %}
                                    <a href="{{ path('setono_sylius_cms_admin_entry_show', {'uuid': homepage.homepage.uuid}) }}">{{ cms_admin_entry_row(homepage.homepage).title|default('setono_sylius_cms.ui.untitled'|trans) }}</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endif %}
