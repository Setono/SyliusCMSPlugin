{#
 # The entry lists' Create, the grid action type setono_sylius_cms_create_entry: the create dialog, for the content type
 # in options.contentType, or asking for the content type when there's none, as in All entries. In a collection's list
 # of its entries and its categories, options.collection names it, and the dialog asks which of the two
 #}
{% set collection = options.collection|default(null) is null ? null : cms_admin_collection(options.collection) %}
{% include '@SetonoSyliusCMSPlugin/admin/entry/_create_dialog.html.twig' with {
    'content_type': options.contentType|default(null),
    'content_types': collection is null ? null : [collection.entries, collection.categories],
    'label': action.label|default('setono_sylius_cms.ui.create'),
} only %}
