{% form_theme form '@SetonoSyliusCMSPlugin/form/theme.html.twig' %}

{{ form_errors(form) }}
<div class="ui two column stackable grid">
    <div class="column">
        <div class="ui segment">
            {{ form_row(form.code) }}
            {{ form_row(form.template, {'attr': {
                'class': 'js-setono-sylius-cms-template-choice-input',
                'data-collection-container': '.js-setono-sylius-cms-sections-collection',
            }}) }}
        </div>
    </div>
    <div class="column">
        <div class="ui segment js-setono-sylius-cms-sections-container">
            {{ form_row(form.sections, {'attr': {
                'class': 'js-setono-sylius-cms-sections-collection',
            }}) }}

            <div class="hidden" style="display: none;">
                {%- for prototype_name, section_collection_prototype in form.vars.section_collection_prototypes -%}
                    {% form_theme section_collection_prototype '@SetonoSyliusCMSPlugin/form/theme.html.twig' %}
                    <div class="js-setono-sylius-cms-sections-prototype" data-prototype-name="{{ prototype_name }}">
                        {{- form_widget(section_collection_prototype) -}}
                    </div>
                {%- endfor -%}
            </div>
        </div>
    </div>
</div>
