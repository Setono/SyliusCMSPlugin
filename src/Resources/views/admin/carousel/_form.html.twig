{% form_theme form '@SetonoSyliusCMSPlugin/form/theme.html.twig' %}

{{ form_errors(form) }}
<div class="ui two column stackable grid">
    <div class="column">
        <div class="ui segment">
            {{ form_row(form.code) }}
            {{ form_row(form.internalDescription) }}
            {{ form_row(form.configuration) }}
        </div>
    </div>
    <div class="column">
        <div class="ui segment">
            {{ form_row(form.slides) }}
        </div>
    </div>
</div>
