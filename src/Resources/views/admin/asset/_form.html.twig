{# @var resource \Setono\SyliusCMSPlugin\Model\AssetInterface #}
{{ form_errors(form) }}
<div class="ui two column stackable grid">
    <div class="column">
        {{ form_row(form.name) }}
        {{ form_row(form.file) }}
        {{ form_row(form.internalDescription) }}
    </div>
    <div class="column">
        {% if resource.path is not null %}
            {{ sscms_preview(resource) }}

            <div class="ui segment">
                <div><a href="{{ url('setono_sylius_cms_view_asset', {'id': resource.id}) }}" target="_blank">View</a></div>
                <div><a href="{{ url('setono_sylius_cms_download_asset', {'id': resource.id}) }}" target="_blank">Download</a></div>
            </div>
        {% endif %}
    </div>
</div>
{{ form_widget(form.path) }}
{{ form_widget(form.mimeType) }}
