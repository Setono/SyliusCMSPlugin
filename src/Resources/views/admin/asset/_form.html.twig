{# @var resource \Setono\SyliusCMSPlugin\Model\AssetInterface #}
{{ form_errors(form) }}
<div class="ui two column stackable grid">
    <div class="column">
        {{ form_row(form.name) }}
        {{ form_row(form.file) }}
        {{ form_row(form.internalDescription) }}
    </div>
    <div class="column">
        {% if resource.path is not null %}
            {{ sscms_preview(resource) }}

            <div class="ui segment">
                {% set assetUrl = url('setono_sylius_cms_download_asset', {'id': resource.id}) %}
                <div>
                    URL:
                    <a href="{{ assetUrl }}" target="_blank">
                        {{ assetUrl }}
                    </a>
                </div>
                <div>
                    Path:
                    {{ resource.path }}
                </div>
            </div>
        {% endif %}
    </div>
</div>
{{ form_widget(form.path) }}
{{ form_widget(form.mimeType) }}
