{% from '@SyliusAdmin/Macro/translationForm.html.twig' import translationForm %}

{% form_theme form '@SetonoSyliusCMSPlugin/form/theme.html.twig' %}

<!-- todo should go in a separate css file -->
<style>
    .codex-editor {
        border: 1px solid rgba(34, 36, 38, 0.1);
        box-shadow: 0 2px 4px 0 rgb(34 36 38 / 3%);
        border-radius: 5px;
    }
</style>

{{ form_errors(form) }}
<div class="ui two column stackable grid">
    <div class="column">
        <div class="ui segment">
            {{ form_row(form.code) }}
            {{ form_row(form.defaultRawContent) }}
        </div>
    </div>
    <div class="column">
        {{ translationForm(form.translations) }}
    </div>
</div>

<script src="{{ asset('bundles/setonosyliuscmsplugin/js/editor.js') }}"></script>
<script src="{{ asset('bundles/setonosyliuscmsplugin/js/header.js') }}"></script>
<script src="{{ asset('bundles/setonosyliuscmsplugin/js/raw.js') }}"></script>
<script src="{{ asset('bundles/setonosyliuscmsplugin/js/imageTool.js') }}"></script>

{% set blocks = {} %}
{% if resource is defined and resource.id is not null %}
    {% set blocks = resource.defaultRawContent %}
{% else %}
    {% set blocks = '{
        "time" : 1628862398590,
        "blocks" : [
            {
                "id" : "uFDH2xSH2S",
                "type" : "paragraph",
                "data" : {
                    "text" : "Hey. Meet the new Editor. On this page you can see it in action — try to edit this text."
                }
            }
        ],
        "version" : "2.22.2"
    }' %}
{% endif %}

<script>
    const editors = [];
    document.querySelectorAll('.editorjs').forEach((holderElement) => {
        let editorOptions = {
            holder: holderElement.id,
            tools: {
                header: {
                    class: Header,
                    inlineToolbar : true
                },
                raw: RawTool,
                image: {
                    class: ImageTool,
                    config: {
                        endpoints: {
                            byFile: '{{ url('setono_sylius_cms_admin_asset_upload_from_editor') }}',
                        }
                    }
                }
            }
        };

        const raw = document.getElementById(holderElement.dataset.source).value;
        if (null !== raw && '' !== raw) {
            editorOptions.data = JSON.parse(raw);
        }

        editors.push({
            obj: new EditorJS(editorOptions),
            source: holderElement.dataset.source
        });
    });

    document.forms['{{ form.vars.name }}'].addEventListener('submit', (e) => {
        editors.forEach((editor) => {
            editor.obj.save().then((json) => {
                const data = JSON.stringify(json);
                document.getElementById(editor.source).value = data;
                console.log('Saving to: ', editor.source);
                console.log('Article data: ', data)
            }).catch((error) => {
                console.log('Saving failed: ', error)
            });
        });

        // e.preventDefault();
        // return false;
    });
</script>
