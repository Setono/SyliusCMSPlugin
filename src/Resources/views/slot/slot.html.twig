{#
 # A slot with something to show (Rendering\SlotRenderer): its wrapper, cms-slot and a modifier of its identifier, around
 # the top-level blocks of the snippets it shows, in editor order. A slot with nothing to show doesn't render this. It gets:
 #   slot      the slot (Registry\SlotMetadata)
 #   snippets  the snippets it shows (Rendering\PlacedSnippet), each with its placement, its blocks that show and the
 #             render context they render with
 #   outlined  whether it's the slot of a snippet's draft in the builder's preview, which outlines and labels it
 #   context   the host-page context the slot provides
 # See "Slots" in docs/spec/slots.md and "Snippet preview" in docs/spec/builder.md
 #}
{%- if outlined -%}
<div data-cms-slot-preview="{{ slot.identifier }}" style="position:relative;margin:0.5rem 0;padding:1.75rem 0.5rem 0.5rem;outline:2px dashed #2563eb;outline-offset:-2px;border-radius:4px">
    <div data-cms-slot-label style="position:absolute;top:0;left:0;padding:0.125rem 0.5rem;border-radius:4px 0 4px 0;background:#2563eb;color:#fff;font:600 12px/1.5 system-ui,sans-serif">{{ slot.label|trans }}</div>
{%- endif -%}
<div class="{{ slot.wrapperClass }}">
    {%- for placed in snippets %}{% with { _cms_render_context: placed.context } %}{{ cms_blocks(placed.blocks) }}{% endwith %}{% endfor -%}
</div>
{%- if outlined -%}
</div>
{%- endif -%}
