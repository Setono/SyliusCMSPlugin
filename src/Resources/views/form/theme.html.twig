{% extends '@!SyliusAdmin/Form/theme.html.twig' %}

{% block setono_sylius_cms_editorjs_widget %}
    <div class="editorjs" id="{{ form.vars.id }}_editorjs" data-source="{{ form.vars.id }}"></div>
    {{- block('hidden_widget') -}}
{% endblock %}

{% block setono_sylius_cms_template_choice_row %}
    <div class="{% if required %}required {% endif %}field{% if (not compound or force_error|default(false)) and not valid %} error{% endif %}">
        {{- form_label(form) -}}
        {% set attr = attr|merge({'class': attr.class|default ~ ' ui dropdown'}) %}
        {{- form_widget(form, {'attr': attr}) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block carousel_block_widget %}
    <div class="ui grid">
        <div class="eleven wide column">
            {{ form_row(form.block) }}
        </div>
        <div class="five wide column">
            {{ form_row(form.position) }}
        </div>
    </div>
{% endblock %}

{% block setono_sylius_cms_block_autocomplete_choice_widget %}
    {{ form_row(form, {
        'remote_url': path('setono_sylius_cms_admin_ajax_block_by_code_phrase'),
        'load_edit_url': path('setono_sylius_cms_admin_ajax_block_by_code')
    }) }}
{% endblock %}

{% block setono_sylius_cms_block_autocomplete_choice_row %}
    {{ form_row(form, {
        'remote_url': path('setono_sylius_cms_admin_ajax_block_by_code_phrase'),
        'load_edit_url': path('setono_sylius_cms_admin_ajax_block_by_code')
    }) }}
{% endblock %}
