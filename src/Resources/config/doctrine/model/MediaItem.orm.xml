<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
    A media item: its file's place in the plugin's storage, what was read from the file, and the metadata editors give
    it. Its alt text is in its translations, which Sylius maps. Deleting its folder puts it in Unsorted, and deleting its
    poster leaves a video without one
    -->
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\MediaItem" table="setono_sylius_cms__media_item">
        <indexes>
            <!-- Finds an uploaded file's duplicates -->
            <index name="setono_sylius_cms__media_item_checksum_idx" columns="checksum"/>
            <!-- The library lists the newest first -->
            <index name="setono_sylius_cms__media_item_created_idx" columns="created_at"/>
        </indexes>

        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="uuid" type="guid" unique="true"/>
        <field name="kind" type="string" length="16" enum-type="Setono\SyliusCMSPlugin\Media\MediaKind"/>
        <field name="name" type="string"/>
        <field name="originalFilename" column="original_filename" type="string"/>
        <!-- Under the UUID in the plugin's storage, and new for every file it gets -->
        <field name="path" type="string" unique="true"/>
        <field name="mimeType" column="mime_type" type="string" length="127"/>
        <field name="size" type="integer"/>
        <field name="width" type="integer" nullable="true"/>
        <field name="height" type="integer" nullable="true"/>
        <field name="credit" type="string" nullable="true"/>
        <field name="focalPointX" column="focal_point_x" type="float"/>
        <field name="focalPointY" column="focal_point_y" type="float"/>
        <!-- The SHA-256 of the stored file -->
        <field name="checksum" type="string" length="64"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="changedAt" column="changed_at" type="datetime_immutable"/>

        <many-to-one field="folder" target-entity="Setono\SyliusCMSPlugin\Model\MediaFolderInterface">
            <join-column name="folder_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>

        <many-to-one field="poster" target-entity="Setono\SyliusCMSPlugin\Model\MediaItemInterface">
            <join-column name="poster_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>
    </mapped-superclass>
</doctrine-mapping>
