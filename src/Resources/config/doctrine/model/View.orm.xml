<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\View"
                       table="setono_sylius_cms__view">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" column="code" type="string"/>
        <field name="enabled" type="boolean"/>
        <field name="template" type="string"/>
        <field name="internalDescription" type="text" nullable="true"/>

        <one-to-many field="viewBlocks" target-entity="Setono\SyliusCMSPlugin\Model\ViewBlockInterface" mapped-by="view" orphan-removal="true" fetch="EAGER">
            <cascade>
                <cascade-all/>
            </cascade>
            <order-by>
                <order-by-field name="position" />
            </order-by>
        </one-to-many>

        <unique-constraints>
            <unique-constraint columns="code"/>
        </unique-constraints>
    </mapped-superclass>
</doctrine-mapping>
