<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
    Every content type is a subclass of Entry in this one table (ADR 0001). The discriminator is the content type's code,
    and Setono\SyliusCMSPlugin\Doctrine\DiscriminatorMapListener adds the registered content types to the map.
    The abstract root itself is mapped to "entry" only so Doctrine never builds a default map from class names
    -->
    <entity name="Setono\SyliusCMSPlugin\Model\Entry"
            table="setono_sylius_cms__entry"
            inheritance-type="SINGLE_TABLE"
            repository-class="Setono\SyliusCMSPlugin\Repository\EntryRepository">
        <discriminator-column name="content_type" type="string" length="64"/>
        <discriminator-map>
            <discriminator-mapping value="entry" class="Setono\SyliusCMSPlugin\Model\Entry"/>
        </discriminator-map>

        <indexes>
            <!-- Finds the entries whose problem counts were made with other code, which every admin page asks -->
            <index name="setono_sylius_cms__entry_problems_counted_with_idx" columns="problems_counted_with"/>
        </indexes>

        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="uuid" type="guid" unique="true"/>
        <!-- Text, not a database JSON type: MySQL's JSON type reorders keys, and the column holds canonical JSON -->
        <field name="blockTree" column="block_tree" type="text"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="changedAt" column="changed_at" type="datetime_immutable"/>
        <field name="lastPublishedAt" column="last_published_at" type="datetime_immutable" nullable="true"/>
        <!-- Who saved last and when (in UTC), for the admin's lists. The name, not a reference, so it outlives the admin user -->
        <field name="lastEditedAt" column="last_edited_at" type="datetime_immutable"/>
        <field name="lastEditedBy" column="last_edited_by" type="string" nullable="true"/>
        <!-- "Hide from search engines", for a content type with its own URL. Drafted, so the column holds the published value -->
        <field name="noindex" type="boolean"/>

        <!-- The on-save settings, as columns and rows the visible-entries query filters on. The date window is in UTC -->
        <field name="enabled" type="boolean"/>
        <field name="showFrom" column="show_from" type="datetime_immutable" nullable="true"/>
        <field name="showUntil" column="show_until" type="datetime_immutable" nullable="true"/>
        <field name="audienceMode" column="audience_mode" type="string" length="16"/>
        <!-- Where it sits among the entries of a content type ordered by position, or null for one ordered otherwise -->
        <field name="position" type="integer" nullable="true"/>

        <!--
        How many errors and warnings the working copy has, of the problem kinds that don't depend on time, and the
        fingerprint of the code they were counted with, or null until they're counted. A write counts them again for
        the entries it touches, in SQL (Problem\ProblemCountUpdater), and the admin's lists and Content badge read them
        in SQL (Problem\ProblemCountProvider), never through the entry
        -->
        <field name="problemErrors" column="problem_errors" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="problemWarnings" column="problem_warnings" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="problemsCountedWith" column="problems_counted_with" type="string" length="64" nullable="true"/>
        <!--
        The locales the working copy is complete in, by code, each between commas, such as ",da_DK,en_US,", or null
        until it's counted. It's counted with the problems, and the Overview's Translations and the lists' translation
        filter read it in SQL (Query\CompletenessQuery), never through the entry
        -->
        <field name="completeLocales" column="complete_locales" type="text" nullable="true"/>

        <one-to-many field="translations" target-entity="Setono\SyliusCMSPlugin\Model\EntryTranslation"
                     mapped-by="translatable" index-by="locale" fetch="EXTRA_LAZY" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="channels" target-entity="Setono\SyliusCMSPlugin\Model\EntryChannelInterface" mapped-by="entry" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="audienceGroups" target-entity="Setono\SyliusCMSPlugin\Model\EntryAudienceGroupInterface" mapped-by="entry" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
