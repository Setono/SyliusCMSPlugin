<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\ViewBlock"
                       table="setono_sylius_cms__view_block">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <many-to-one field="view" target-entity="Setono\SyliusCMSPlugin\Model\ViewInterface" inversed-by="viewBlocks">
            <join-column name="view_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <many-to-one field="block" target-entity="Setono\SyliusCMSPlugin\Model\BlockInterface" fetch="EAGER">
            <join-column name="block_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <field name="section" type="string"/>
        <field name="priority" type="integer"/>
    </mapped-superclass>
</doctrine-mapping>
