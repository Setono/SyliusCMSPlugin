<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
    An import started in the admin: where its uploaded zip is kept in the media storage until it finishes or is
    abandoned, its dry run's result and its own, as JSON, and the options it was confirmed with. The Transfer screen
    lists the latest
    -->
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\Import" table="setono_sylius_cms__import">
        <indexes>
            <index name="setono_sylius_cms__import_created_at_idx" columns="created_at"/>
        </indexes>

        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="uuid" type="guid" unique="true"/>
        <field name="filename" type="string"/>
        <field name="path" type="string" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="state" type="string" length="16" enum-type="Setono\SyliusCMSPlugin\Transfer\Import\ImportState"/>
        <field name="startedAt" column="started_at" type="datetime_immutable" nullable="true"/>
        <field name="dryRun" column="dry_run" type="json" nullable="true"/>
        <field name="overwrite" type="boolean"/>
        <field name="publish" type="boolean"/>
        <field name="result" type="json" nullable="true"/>
        <field name="finishedAt" column="finished_at" type="datetime_immutable" nullable="true"/>
    </mapped-superclass>
</doctrine-mapping>
