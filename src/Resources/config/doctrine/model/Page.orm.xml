<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\Page"
                       table="setono_sylius_cms__page">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="enabled" type="boolean"/>

        <many-to-one field="view" target-entity="Setono\SyliusCMSPlugin\Model\ViewInterface" fetch="EAGER">
            <join-column name="view_id" referenced-column-name="id" nullable="false" />
        </many-to-one>
    </mapped-superclass>
</doctrine-mapping>
