<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\PageTranslation"
                       table="setono_sylius_cms__page_translation">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="title" type="string" nullable="true" />
        <field name="metaDescription" type="text" nullable="true" />
    </mapped-superclass>
</doctrine-mapping>
