<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\Slide"
                       table="setono_sylius_cms__carousel_slide" inheritance-type="SINGLE_TABLE">
        <discriminator-column name="type" type="string"/>

        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <many-to-one field="carousel" target-entity="Setono\SyliusCMSPlugin\Model\CarouselInterface" inversed-by="slides">
            <join-column name="carousel_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <field name="position" type="integer"/>
    </mapped-superclass>
</doctrine-mapping>
