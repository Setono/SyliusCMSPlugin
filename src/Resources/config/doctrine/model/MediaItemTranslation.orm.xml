<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- A media item's alt text in one locale. A locale without alt text has no row. Sylius maps the locale and the media item -->
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\MediaItemTranslation" table="setono_sylius_cms__media_item_translation">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="altText" column="alt_text" type="text" nullable="true"/>
    </mapped-superclass>
</doctrine-mapping>
