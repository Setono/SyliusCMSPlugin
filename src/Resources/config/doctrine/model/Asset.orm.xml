<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\Asset"
                       table="setono_sylius_cms__asset">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="name" type="string"/>
        <field name="path" column="path" type="string"/>
        <field name="mimeType" type="string" nullable="true"/>

        <unique-constraints>
            <unique-constraint columns="path"/>
        </unique-constraints>
    </mapped-superclass>
</doctrine-mapping>
