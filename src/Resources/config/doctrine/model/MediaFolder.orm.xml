<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- A folder of the media library, in another folder or at the top. Its media items point at it -->
    <mapped-superclass name="Setono\SyliusCMSPlugin\Model\MediaFolder" table="setono_sylius_cms__media_folder">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="uuid" type="guid" unique="true"/>
        <field name="name" type="string"/>

        <many-to-one field="parent" target-entity="Setono\SyliusCMSPlugin\Model\MediaFolderInterface">
            <join-column name="parent_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>
    </mapped-superclass>
</doctrine-mapping>
