<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_cms.generator.page.preview_link"
                 class="Setono\SyliusCMSPlugin\Generator\Page\PreviewLinkGenerator">
            <argument type="service" id="router"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Generator\Page\PreviewLinkGeneratorInterface"
                 alias="setono_sylius_cms.generator.page.preview_link"/>

        <!-- Twig generators -->
        <service id="setono_sylius_cms.generator.twig.composite"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\CompositeTwigGenerator"/>

        <service id="Setono\SyliusCMSPlugin\Generator\Twig\AssetTwigGenerator">
            <argument type="service" id="twig"/>
            <argument>%setono_sylius_cms.model.asset.class%</argument>
            <argument>@SetonoSyliusCMSPlugin/twig_generator/asset.html.twig</argument>

            <tag name="setono_sylius_cms.twig_generator"/>
        </service>

        <service id="setono_sylius_cms.generator.twig.block"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\GenericTwigGenerator">
            <argument type="service" id="twig"/>
            <argument>%setono_sylius_cms.model.block.class%</argument>
            <argument>@SetonoSyliusCMSPlugin/twig_generator/block.html.twig</argument>

            <tag name="setono_sylius_cms.twig_generator"/>
        </service>

        <service id="setono_sylius_cms.generator.twig.carousel"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\GenericTwigGenerator">
            <argument type="service" id="twig"/>
            <argument>%setono_sylius_cms.model.carousel.class%</argument>
            <argument>@SetonoSyliusCMSPlugin/twig_generator/carousel.html.twig</argument>

            <tag name="setono_sylius_cms.twig_generator"/>
        </service>

        <service id="setono_sylius_cms.generator.twig.page"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\GenericTwigGenerator">
            <argument type="service" id="twig"/>
            <argument>%setono_sylius_cms.model.page.class%</argument>
            <argument>@SetonoSyliusCMSPlugin/twig_generator/page.html.twig</argument>

            <tag name="setono_sylius_cms.twig_generator"/>
        </service>

        <!-- Misc -->
        <service id="setono_sylius_cms.generator.path"
                 class="Setono\SyliusCMSPlugin\Generator\PathGenerator"/>

        <service id="setono_sylius_cms.generator.element_identifier"
                 class="Setono\SyliusCMSPlugin\Generator\ElementIdentifierGenerator"/>
    </services>
</container>
