<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_cms.generator.path"
                 class="Setono\SyliusCMSPlugin\Generator\PathGenerator"/>

        <service id="setono_sylius_cms.generator.page.preview_link"
                 class="Setono\SyliusCMSPlugin\Generator\Page\PreviewLinkGenerator">
            <argument type="service" id="router"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Generator\Page\PreviewLinkGeneratorInterface"
                 alias="setono_sylius_cms.generator.page.preview_link"/>

        <!-- Twig generators -->
        <service id="setono_sylius_cms.generator.twig.asset"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\AssetTwigGenerator">
            <argument type="service" id="router"/>
        </service>

        <service id="setono_sylius_cms.generator.twig.block"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\BlockTwigGenerator"/>

        <service id="setono_sylius_cms.generator.twig.carousel"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\CarouselTwigGenerator"/>

        <service id="setono_sylius_cms.generator.twig.page"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\PageTwigGenerator">
            <argument type="service" id="setono_editorjs.parser"/>
            <argument type="service" id="setono_editorjs.renderer"/>
        </service>

        <service id="setono_sylius_cms.generator.twig.view"
                 class="Setono\SyliusCMSPlugin\Generator\Twig\ViewTwigGenerator"/>
    </services>
</container>
