<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusCMSPlugin\Rendering\ShopRenderContextFactory" class="Setono\SyliusCMSPlugin\Rendering\ShopRenderContextFactory">
            <argument type="service" id="sylius.context.channel"/>
            <argument type="service" id="sylius.context.locale"/>
            <argument type="service" id="sylius.context.currency"/>
            <argument type="service" id="sylius.context.customer"/>
            <argument type="service" id="clock"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewContext"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Rendering\RenderContextFactoryInterface" alias="Setono\SyliusCMSPlugin\Rendering\ShopRenderContextFactory"/>

        <service id="Setono\SyliusCMSPlugin\Rendering\BlockHydrator" class="Setono\SyliusCMSPlugin\Rendering\BlockHydrator">
            <argument type="service" id="Setono\SyliusCMSPlugin\Field\FieldHandlerLocator"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Localization\FallbackValues"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Rendering\ParamsHydrator" class="Setono\SyliusCMSPlugin\Rendering\ParamsHydrator">
            <argument type="service" id="Setono\SyliusCMSPlugin\Field\FieldHandlerLocator"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Localization\FallbackValues"/>
        </service>

        <!-- The references a stored tree holds, through the field type handlers: for rendering, the admin's broken references and the usage index -->
        <!-- Walks the values of a block tree the way it renders, for the reference finder and the problem kinds -->
        <service id="Setono\SyliusCMSPlugin\Tree\TreeValues" class="Setono\SyliusCMSPlugin\Tree\TreeValues">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\LayoutRegistryInterface"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Tree\ReferenceFinder" class="Setono\SyliusCMSPlugin\Tree\ReferenceFinder">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\TreeValues"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Field\FieldHandlerLocator"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Rendering\BlockViewBuilder" class="Setono\SyliusCMSPlugin\Rendering\BlockViewBuilder">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\BlockHydrator"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Condition\ConditionMatcher"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\ReferenceFinder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\ReferenceLoaderInterface"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Rendering\TwigBlockRenderer" class="Setono\SyliusCMSPlugin\Rendering\TwigBlockRenderer">
            <argument type="service" id="twig"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Rendering\BlockRendererInterface" alias="Setono\SyliusCMSPlugin\Rendering\TwigBlockRenderer"/>

        <!-- Renders an entry with its own URL in its layout: at its URL, and as a homepage -->
        <service id="Setono\SyliusCMSPlugin\Rendering\LayoutRenderer" class="Setono\SyliusCMSPlugin\Rendering\LayoutRenderer">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\LayoutRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Upgrade\StoredDataUpgraderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\BlockViewBuilder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\BlockHydrator"/>
            <argument type="service" id="twig"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\ReferenceFinder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\ReferenceLoaderInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Rendering\LayoutRendererInterface" alias="Setono\SyliusCMSPlugin\Rendering\LayoutRenderer"/>

        <!--
        Loads every reference a tree holds before it renders, with one query per type. A project can decorate it to cache
        references. Each type loads through the service tagged setono_sylius_cms.reference_type_loader with its type
        -->
        <service id="Setono\SyliusCMSPlugin\Rendering\ReferenceLoader" class="Setono\SyliusCMSPlugin\Rendering\ReferenceLoader">
            <argument type="tagged_locator" tag="setono_sylius_cms.reference_type_loader" index-by="type"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Rendering\ReferenceLoaderInterface" alias="Setono\SyliusCMSPlugin\Rendering\ReferenceLoader"/>

        <!-- The entries, products and taxons references name, those the shopper may see through the visible queries -->
        <service id="Setono\SyliusCMSPlugin\Rendering\EntryReferenceLoader" class="Setono\SyliusCMSPlugin\Rendering\EntryReferenceLoader">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleEntriesQueryInterface"/>

            <tag name="setono_sylius_cms.reference_type_loader" type="entry"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Rendering\ProductReferenceLoader" class="Setono\SyliusCMSPlugin\Rendering\ProductReferenceLoader">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleProductsQueryInterface"/>
            <argument type="service" id="doctrine"/>
            <argument>%sylius.model.product.class%</argument>

            <tag name="setono_sylius_cms.reference_type_loader" type="product"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Rendering\TaxonReferenceLoader" class="Setono\SyliusCMSPlugin\Rendering\TaxonReferenceLoader">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleTaxonsQueryInterface"/>
            <argument type="service" id="doctrine"/>
            <argument>%sylius.model.taxon.class%</argument>

            <tag name="setono_sylius_cms.reference_type_loader" type="taxon"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Rendering\EntryUrlLookup" class="Setono\SyliusCMSPlugin\Rendering\EntryUrlLookup">
            <argument type="service" id="doctrine"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Rendering\EntryUrlLookupInterface" alias="Setono\SyliusCMSPlugin\Rendering\EntryUrlLookup"/>
    </services>
</container>
