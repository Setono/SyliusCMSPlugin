<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="setono_sylius_cms.controller.action.admin.upload_editor_picture"
                 class="Setono\SyliusCMSPlugin\Controller\Action\Admin\UploadEditorPictureAction">
            <argument type="service" id="setono_sylius_cms.factory.asset"/>
            <argument type="service" id="setono_sylius_cms.repository.asset"/>
            <argument type="service" id="setono_sylius_cms.uploader.asset"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="liip_imagine.cache.manager"/>

            <tag name="controller.service_arguments"/>
        </service>

        <service id="setono_sylius_cms.controller.action.show_page"
                 class="Setono\SyliusCMSPlugin\Controller\Action\ShowPageAction">
            <argument type="service" id="sylius.context.locale"/>
            <argument type="service" id="setono_sylius_cms.repository.page"/>
            <argument type="service" id="twig"/>
            <argument type="service" id="setono_sylius_cms.checker.eligibility.page.composite"/>

            <tag name="controller.service_arguments"/>
        </service>

        <service id="setono_sylius_cms.controller.action.show_tree"
                 class="Setono\SyliusCMSPlugin\Controller\Action\ShowTreeAction">
            <argument type="service" id="setono_sylius_cms.manager.navigation_item"/>

            <tag name="controller.service_arguments"/>
        </service>

        <service id="setono_sylius_cms.controller.action.download_asset"
                 class="Setono\SyliusCMSPlugin\Controller\Action\DownloadAssetAction">
            <argument type="service" id="setono_sylius_cms.repository.asset"/>
            <argument type="service">
                <service class="Gaufrette\Filesystem">
                    <argument>%setono_sylius_cms.asset_adapter%</argument>
                    <factory service="knp_gaufrette.filesystem_map" method="get" />
                </service>
            </argument>

            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>
