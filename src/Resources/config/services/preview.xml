<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewTokenSigner" class="Setono\SyliusCMSPlugin\Preview\PreviewTokenSigner">
            <argument>%kernel.secret%</argument>
            <argument type="service" id="clock"/>
        </service>

        <!-- Reads the builder's preview tokens and share links' tokens. cms_preview_mode() reads it through CMSRuntime -->
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewContext" class="Setono\SyliusCMSPlugin\Preview\PreviewContext">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewTokenSigner"/>
            <argument type="service_closure" id="Setono\SyliusCMSPlugin\Repository\ShareLinkRepositoryInterface"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Preview\PreviewedEntryProvider" class="Setono\SyliusCMSPlugin\Preview\PreviewedEntryProvider">
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewContext"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\WorkingCopyProviderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\RevisionRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Revision\RevisionReader"/>
        </service>

        <!-- Where Shown to and Date start in the builder's preview, and what a share link fixes them at -->
        <service id="Setono\SyliusCMSPlugin\Preview\StartingValues" class="Setono\SyliusCMSPlugin\Preview\StartingValues">
            <argument type="service" id="sylius.repository.customer_group"/>
            <argument type="service" id="clock"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Preview\StartingValuesInterface" alias="Setono\SyliusCMSPlugin\Preview\StartingValues"/>

        <!-- The render context of a preview that's being made, before its token is in a request -->
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewRenderContextFactory" class="Setono\SyliusCMSPlugin\Preview\PreviewRenderContextFactory">
            <argument type="service" id="clock"/>
        </service>

        <!-- The sample objects a snippet's preview shows it with, and the one it starts with -->
        <service id="Setono\SyliusCMSPlugin\Preview\SampleCandidates" class="Setono\SyliusCMSPlugin\Preview\SampleCandidates">
            <argument type="service" id="Setono\SyliusCMSPlugin\Condition\ConditionMatcher"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\ReferenceLoaderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleProductsQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Source\Product\TaxonFilter"/>
            <argument type="tagged_locator" tag="setono_sylius_cms.search" index-by="kind"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Preview\SampleCandidatesInterface" alias="Setono\SyliusCMSPlugin\Preview\SampleCandidates"/>

        <service id="Setono\SyliusCMSPlugin\Preview\SampleObjects" class="Setono\SyliusCMSPlugin\Preview\SampleObjects">
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\SampleCandidatesInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\ReferenceLoaderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Condition\ConditionMatcher"/>
        </service>

        <!-- The host-page context of the previewed entry's own tree: itself, or a snippet's sample object -->
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewedHostPageContext" class="Setono\SyliusCMSPlugin\Preview\PreviewedHostPageContext">
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewContext"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\SampleObjects"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\RenderContextFactoryInterface"/>
        </service>

        <!-- The real shop page a slot renders on, which a project decorates for a slot of its own -->
        <service id="Setono\SyliusCMSPlugin\Preview\HostPageUrlGenerator" class="Setono\SyliusCMSPlugin\Preview\HostPageUrlGenerator">
            <argument type="service" id="router"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Seo\CanonicalUrlGeneratorInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Preview\HostPageUrlGeneratorInterface" alias="Setono\SyliusCMSPlugin\Preview\HostPageUrlGenerator"/>

        <!-- Where a snippet's preview and share links show it: the host page of one of its placements, or a plain page -->
        <service id="Setono\SyliusCMSPlugin\Preview\SnippetHostPages" class="Setono\SyliusCMSPlugin\Preview\SnippetHostPages">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\PlacementRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SlotRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\SampleObjects"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\HostPageUrlGeneratorInterface"/>
            <argument type="service" id="router"/>
        </service>

        <!-- Lets the placement a snippet's preview or share link shows win in its slot with the snippet's draft -->
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewPlacementPicker" class="Setono\SyliusCMSPlugin\Preview\PreviewPlacementPicker"
                 decorates="Setono\SyliusCMSPlugin\Rendering\PlacementPickerInterface">
            <argument type="service" id=".inner"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewContext"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewedEntryProvider"/>
        </service>

        <!-- Ahead of Sylius's hostname-based channel context, which has the default priority 0 -->
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewChannelContext" class="Setono\SyliusCMSPlugin\Preview\PreviewChannelContext">
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewContext"/>
            <argument type="service" id="sylius.repository.channel"/>

            <tag name="sylius.context.channel" priority="128"/>
        </service>

        <!-- Ahead of Sylius's admin-based locale context (128) and its request-based one (64) -->
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewLocaleContext" class="Setono\SyliusCMSPlugin\Preview\PreviewLocaleContext">
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewContext"/>

            <tag name="sylius.context.locale" priority="256"/>
        </service>

        <!-- Adds the markers, and shows a block's error in place of its output, in the builder's preview -->
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewBlockRenderer" class="Setono\SyliusCMSPlugin\Preview\PreviewBlockRenderer"
                 decorates="Setono\SyliusCMSPlugin\Rendering\BlockRendererInterface">
            <argument type="service" id=".inner"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Follows a block whose link doesn't resolve with a notice, in the builder's preview, inside the block's markers -->
        <service id="Setono\SyliusCMSPlugin\Preview\UnresolvedLinkNotices" class="Setono\SyliusCMSPlugin\Preview\UnresolvedLinkNotices"
                 decorates="Setono\SyliusCMSPlugin\Rendering\BlockRendererInterface" decoration-priority="10">
            <argument type="service" id=".inner"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="translator"/>
        </service>

        <!-- Marks the fields cms_field() prints that editors can type in place, in the builder's preview -->
        <service id="Setono\SyliusCMSPlugin\Preview\FieldMarker" class="Setono\SyliusCMSPlugin\Preview\FieldMarker">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
        </service>

        <!-- Sets _cms_preview_mode before the router listener (32), and the headers after the session listener (-1000) -->
        <service id="Setono\SyliusCMSPlugin\Preview\PreviewModeListener" class="Setono\SyliusCMSPlugin\Preview\PreviewModeListener">
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewContext"/>

            <tag name="kernel.event_listener" event="kernel.request" method="onRequest" priority="64"/>
            <tag name="kernel.event_listener" event="kernel.response" method="onResponse" priority="-1010"/>
        </service>

        <!-- After the profiler's toolbar (-128) and the preview headers (-1010) -->
        <service id="Setono\SyliusCMSPlugin\Preview\BridgeScriptListener" class="Setono\SyliusCMSPlugin\Preview\BridgeScriptListener">
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewContext"/>
            <argument type="service" id="twig"/>

            <tag name="kernel.event_listener" event="kernel.response" method="onResponse" priority="-1020"/>
        </service>
    </services>
</container>
