<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Stores a revision on every publish -->
        <service id="Setono\SyliusCMSPlugin\Revision\RevisionRecorder" class="Setono\SyliusCMSPlugin\Revision\RevisionRecorder">
            <argument type="service" id="setono_sylius_cms.factory.revision"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\EntryFormat\EntryNormalizer"/>
            <argument type="service" id="setono_sylius_cms.manager.revision"/>
            <argument type="service" id="security.token_storage"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Revision\RevisionRecorderInterface" alias="Setono\SyliusCMSPlugin\Revision\RevisionRecorder"/>

        <!-- Reads revisions upgraded -->
        <service id="Setono\SyliusCMSPlugin\Revision\RevisionReader" class="Setono\SyliusCMSPlugin\Revision\RevisionReader">
            <argument type="service" id="Setono\SyliusCMSPlugin\Upgrade\StoredDataUpgraderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\EntryFormat\EntryDenormalizer"/>
        </service>

        <!-- Copies a revision into the draft -->
        <service id="Setono\SyliusCMSPlugin\Revision\RevisionRestorer" class="Setono\SyliusCMSPlugin\Revision\RevisionRestorer">
            <argument type="service" id="Setono\SyliusCMSPlugin\Revision\RevisionReader"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\AutosaveInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Revision\RevisionRestorerInterface" alias="Setono\SyliusCMSPlugin\Revision\RevisionRestorer"/>

        <!-- The URL of a revision's read-only preview -->
        <service id="Setono\SyliusCMSPlugin\Revision\RevisionPreviewUrlGenerator" class="Setono\SyliusCMSPlugin\Revision\RevisionPreviewUrlGenerator">
            <argument type="service" id="Setono\SyliusCMSPlugin\Revision\RevisionReader"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="sylius.repository.channel"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewTokenSigner"/>
            <argument type="service" id="router"/>
        </service>

        <!-- Deletes the revisions beyond revisions.keep per entry, for setono:cms:revisions:prune -->
        <service id="Setono\SyliusCMSPlugin\Revision\RevisionPruner" class="Setono\SyliusCMSPlugin\Revision\RevisionPruner">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\RevisionRepositoryInterface"/>
            <argument>%setono_sylius_cms.revisions.keep%</argument>
        </service>
    </services>
</container>
