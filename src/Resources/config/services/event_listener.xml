<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_cms.event_listener.element_cache_invalidator"
                 class="Setono\SyliusCMSPlugin\EventListener\ElementCacheInvalidatorListener">
            <argument type="service" id="sylius.repository.channel"/>
            <argument type="service" id="setono_twig_cache_purger.purger.default"/>

            <tag name="doctrine.event_listener" event="postPersist"/>
            <tag name="doctrine.event_listener" event="postUpdate"/>
            <tag name="doctrine.event_listener" event="postRemove"/>
        </service>

        <service id="setono_sylius_cms.event_listener.doctrine.set_asset_code"
                 class="Setono\SyliusCMSPlugin\EventListener\Doctrine\SetAssetCodeListener">
            <argument type="service" id="setono_sylius_cms.repository.asset"/>

            <tag name="doctrine.event_listener" event="prePersist"/>
            <tag name="doctrine.event_listener" event="preUpdate"/>
        </service>

        <service id="setono_sylius_cms.event_listener.doctrine.template_cache_invalidator"
                 class="Setono\SyliusCMSPlugin\EventListener\Doctrine\TemplateCacheInvalidatorListener">
            <argument type="service" id="setono_twig_cache_purger.purger.default"/>

            <tag name="doctrine.event_listener" event="postPersist"/>
            <tag name="doctrine.event_listener" event="postUpdate"/>
            <tag name="doctrine.event_listener" event="postRemove"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\EventListener\Doctrine\SlideDiscriminatorMapListener">
            <argument>%sylius.resources%</argument>

            <tag name="doctrine.event_listener" event="loadClassMetadata"/>
        </service>
    </services>
</container>
