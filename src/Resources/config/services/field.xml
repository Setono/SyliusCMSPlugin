<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Field type handlers are found by the service id their field attribute names in handledBy(): the attribute's class plus "Handler" -->
        <service id="Setono\SyliusCMSPlugin\Field\FieldHandlerLocator" class="Setono\SyliusCMSPlugin\Field\FieldHandlerLocator">
            <argument type="tagged_locator" tag="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\TextHandler" class="Setono\SyliusCMSPlugin\Field\TextHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\ToggleHandler" class="Setono\SyliusCMSPlugin\Field\ToggleHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\CodeHandler" class="Setono\SyliusCMSPlugin\Field\CodeHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\NumberHandler" class="Setono\SyliusCMSPlugin\Field\NumberHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\RichTextHandler" class="Setono\SyliusCMSPlugin\Field\RichTextHandler">
            <argument type="service" id="Setono\SyliusCMSPlugin\RichText\RichTextSchema"/>
            <!-- Rich text's links resolve through their link targets, like Link fields -->
            <argument type="service" id="Setono\SyliusCMSPlugin\Link\LinkResolver"/>

            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\ChoiceHandler" class="Setono\SyliusCMSPlugin\Field\ChoiceHandler">
            <argument type="service" id="translator"/>
            <!-- The choices providers Choice fields name, by class: services implementing ChoicesProviderInterface, which autoconfiguration tags -->
            <argument type="tagged_locator" tag="setono_sylius_cms.choices_provider"/>

            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\DateHandler" class="Setono\SyliusCMSPlugin\Field\DateHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\DateTimeHandler" class="Setono\SyliusCMSPlugin\Field\DateTimeHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <!-- Media and Media list hydrate their UUIDs from the references loaded before rendering (Rendering\ReferenceLoaderInterface) -->
        <service id="Setono\SyliusCMSPlugin\Field\MediaHandler" class="Setono\SyliusCMSPlugin\Field\MediaHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\MediaListHandler" class="Setono\SyliusCMSPlugin\Field\MediaListHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <!-- Product, Taxon and the list fields Products and Taxons hydrate their codes from the references loaded before rendering, which the visible-products and visible-taxons queries load -->
        <service id="Setono\SyliusCMSPlugin\Field\ProductHandler" class="Setono\SyliusCMSPlugin\Field\ProductHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Field\TaxonHandler" class="Setono\SyliusCMSPlugin\Field\TaxonHandler">
            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <!-- A list field a source fills resolves the source when a template first reads it -->
        <service id="Setono\SyliusCMSPlugin\Field\ListFieldHandler" class="Setono\SyliusCMSPlugin\Field\ListFieldHandler">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SourceRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Source\SourceResolver"/>

            <tag name="setono_sylius_cms.field_handler"/>
        </service>

        <!-- Link resolves its link through its link target, a link to a record from the references loaded before rendering -->
        <service id="Setono\SyliusCMSPlugin\Field\LinkHandler" class="Setono\SyliusCMSPlugin\Field\LinkHandler">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\LinkTargetRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Link\LinkResolver"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Localization\FallbackChainInterface"/>

            <tag name="setono_sylius_cms.field_handler"/>
        </service>
    </services>
</container>
