<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <parameter key="setono_sylius_cms.renderer.carousel_template">@SetonoSyliusCMSPlugin/carousel/template.html.twig</parameter>
    </parameters>

    <services>
        <service id="setono_sylius_cms.renderer.block"
                 class="Setono\SyliusCMSPlugin\Renderer\BlockRenderer">
            <argument type="service" id="setono_sylius_cms.repository.block"/>
            <argument type="service" id="twig"/>
            <argument type="service" id="setono_sylius_cms.stack.element"/>
            <argument>%kernel.debug%</argument>
            <call method="setLogger">
                <argument type="service" id="logger"/>
            </call>
        </service>

        <service id="setono_sylius_cms.cached_renderer.block"
                 class="Setono\SyliusCMSPlugin\Renderer\CachedBlockRenderer"
                 decorates="setono_sylius_cms.renderer.block">
            <argument type="service" id=".inner"/>
            <argument type="service" id="sscms_elements_cache_pool"/>
            <argument type="service" id="setono_sylius_cms.generator.element_cache_key"/>
            <argument>%setono_sylius_cms.cache_ttl%</argument>
            <argument>%setono_sylius_cms.model.block.class%</argument>
        </service>

        <service id="setono_sylius_cms.renderer.carousel"
                 class="Setono\SyliusCMSPlugin\Renderer\CarouselRenderer">
            <argument type="service" id="setono_sylius_cms.repository.carousel"/>
            <argument type="service" id="twig"/>
            <argument type="service" id="setono_sylius_cms.renderer.block"/>
            <argument type="service" id="setono_sylius_cms.stack.element"/>
            <argument>%setono_sylius_cms.renderer.carousel_template%</argument>
            <argument>%kernel.debug%</argument>
            <call method="setLogger">
                <argument type="service" id="logger"/>
            </call>
        </service>
        <service id="Setono\SyliusCMSPlugin\Renderer\CarouselRendererInterface"
                 alias="setono_sylius_cms.renderer.carousel"/>

        <service id="setono_sylius_cms.cached_renderer.carousel"
                 class="Setono\SyliusCMSPlugin\Renderer\CachedCarouselRenderer"
                 decorates="setono_sylius_cms.renderer.carousel">
            <argument type="service" id=".inner"/>
            <argument type="service" id="sscms_elements_cache_pool"/>
            <argument type="service" id="setono_sylius_cms.generator.element_cache_key"/>
            <argument>%setono_sylius_cms.cache_ttl%</argument>
            <argument>%setono_sylius_cms.model.carousel.class%</argument>
        </service>

        <service id="setono_sylius_cms.renderer.view"
                 class="Setono\SyliusCMSPlugin\Renderer\ViewRenderer">
            <argument type="service" id="setono_sylius_cms.repository.view"/>
            <argument type="service" id="twig"/>
            <argument type="service" id="setono_sylius_cms.template.registry"/>
            <argument type="service" id="setono_sylius_cms.renderer.block"/>
            <argument type="service" id="setono_sylius_cms.stack.element"/>
            <argument>%kernel.debug%</argument>
            <call method="setLogger">
                <argument type="service" id="logger"/>
            </call>
        </service>

        <service id="setono_sylius_cms.cached_renderer.view"
                 class="Setono\SyliusCMSPlugin\Renderer\CachedViewRenderer"
                 decorates="setono_sylius_cms.renderer.view">
            <argument type="service" id=".inner"/>
            <argument type="service" id="sscms_elements_cache_pool"/>
            <argument type="service" id="setono_sylius_cms.generator.element_cache_key"/>
            <argument>%setono_sylius_cms.cache_ttl%</argument>
            <argument>%setono_sylius_cms.model.view.class%</argument>
        </service>
    </services>
</container>
