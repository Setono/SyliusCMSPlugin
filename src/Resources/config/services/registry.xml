<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusCMSPlugin\Registry\FieldReader" class="Setono\SyliusCMSPlugin\Registry\FieldReader"/>

        <service id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistry" class="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistry">
            <!-- Replaced by RegisterBlockTypesPass with the block type classes by code -->
            <argument type="collection"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\FieldReader"/>
            <argument>%setono_sylius_cms.disabled.block_types%</argument>
            <argument>%setono_sylius_cms.block_styles%</argument>
        </service>
        <service id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface" alias="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistry"/>

        <service id="Setono\SyliusCMSPlugin\Registry\LayoutRegistry" class="Setono\SyliusCMSPlugin\Registry\LayoutRegistry">
            <!-- Replaced by RegisterLayoutsPass with the layout classes by content type and code -->
            <argument type="collection"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\FieldReader"/>
            <argument>%setono_sylius_cms.default_layouts%</argument>
            <argument>%setono_sylius_cms.disabled.layouts%</argument>
        </service>
        <service id="Setono\SyliusCMSPlugin\Registry\LayoutRegistryInterface" alias="Setono\SyliusCMSPlugin\Registry\LayoutRegistry"/>

        <service id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistry" class="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistry">
            <!-- Replaced by RegisterContentTypesPass with the content types' resources, and the URL prefixes set in config,
                 by code, and the codes of those switched off in config -->
            <argument type="collection"/>
            <argument type="collection"/>
            <argument type="collection"/>

            <!-- The condition of the setono_sylius_cms_admin_entry_index route calls it as service('setono_sylius_cms_content_types') -->
            <tag name="routing.condition_service" alias="setono_sylius_cms_content_types"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface" alias="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistry"/>

        <service id="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistry" class="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistry">
            <!-- Replaced by RegisterConditionKindsPass with the condition kind classes by code -->
            <argument type="collection"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\FieldReader"/>
            <!-- Replaced by RegisterConditionKindsPass with a locator of the condition kinds by code -->
            <argument type="collection"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistryInterface" alias="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistry"/>

        <service id="Setono\SyliusCMSPlugin\Registry\SourceRegistry" class="Setono\SyliusCMSPlugin\Registry\SourceRegistry">
            <!-- Replaced by RegisterSourcesPass with the source classes by code -->
            <argument type="collection"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\FieldReader"/>
            <!-- Replaced by RegisterSourcesPass with a locator of the sources by code -->
            <argument type="collection"/>
            <argument>%setono_sylius_cms.disabled.sources%</argument>
        </service>
        <service id="Setono\SyliusCMSPlugin\Registry\SourceRegistryInterface" alias="Setono\SyliusCMSPlugin\Registry\SourceRegistry"/>

        <!-- The slots setono_sylius_cms.slots declares, the stock slots first -->
        <service id="Setono\SyliusCMSPlugin\Registry\SlotRegistry" class="Setono\SyliusCMSPlugin\Registry\SlotRegistry">
            <argument>%setono_sylius_cms.slots%</argument>
        </service>
        <service id="Setono\SyliusCMSPlugin\Registry\SlotRegistryInterface" alias="Setono\SyliusCMSPlugin\Registry\SlotRegistry"/>

        <!-- The context keys setono_sylius_cms.context_keys declares, product, taxon and entry first -->
        <service id="Setono\SyliusCMSPlugin\Registry\ContextKeyRegistry" class="Setono\SyliusCMSPlugin\Registry\ContextKeyRegistry">
            <argument>%setono_sylius_cms.context_keys%</argument>
        </service>
        <service id="Setono\SyliusCMSPlugin\Registry\ContextKeyRegistryInterface" alias="Setono\SyliusCMSPlugin\Registry\ContextKeyRegistry"/>

        <service id="Setono\SyliusCMSPlugin\Registry\NestingRules" class="Setono\SyliusCMSPlugin\Registry\NestingRules">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Registry\NestingRulesInterface" alias="Setono\SyliusCMSPlugin\Registry\NestingRules"/>
    </services>
</container>
