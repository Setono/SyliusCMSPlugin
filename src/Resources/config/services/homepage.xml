<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Everything that changes the channels a page is the homepage of goes through it -->
        <service id="Setono\SyliusCMSPlugin\Homepage\HomepageModifier" class="Setono\SyliusCMSPlugin\Homepage\HomepageModifier">
            <argument type="service" id="setono_sylius_cms.factory.homepage"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\HomepageRepositoryInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Homepage\HomepageModifierInterface" alias="Setono\SyliusCMSPlugin\Homepage\HomepageModifier"/>

        <!-- The page a channel shows at its root URL, when the shopper can see it -->
        <service id="Setono\SyliusCMSPlugin\Homepage\HomepageProvider" class="Setono\SyliusCMSPlugin\Homepage\HomepageProvider">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleEntriesQueryInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Homepage\HomepageProviderInterface" alias="Setono\SyliusCMSPlugin\Homepage\HomepageProvider"/>

        <!-- A homepage's canonical URL is its channel's root, which its canonical and hreflang links and the builder's preview use -->
        <service id="Setono\SyliusCMSPlugin\Homepage\HomepageCanonicalUrlGenerator" class="Setono\SyliusCMSPlugin\Homepage\HomepageCanonicalUrlGenerator"
                 decorates="Setono\SyliusCMSPlugin\Seo\CanonicalUrlGeneratorInterface">
            <argument type="service" id="Setono\SyliusCMSPlugin\Homepage\HomepageCanonicalUrlGenerator.inner"/>
            <argument type="service" id="router"/>
        </service>

        <!-- The page the decorated homepage controller renders: the provider's, or in the builder's preview, the working copy -->
        <service id="Setono\SyliusCMSPlugin\Homepage\HomepageResolver" class="Setono\SyliusCMSPlugin\Homepage\HomepageResolver">
            <argument type="service" id="Setono\SyliusCMSPlugin\Homepage\HomepageProviderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preview\PreviewedEntryProvider"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Homepage\HomepageResolverInterface" alias="Setono\SyliusCMSPlugin\Homepage\HomepageResolver"/>

        <!-- The channels whose homepage is a CMS page, which hides the slots on Sylius's own homepage -->
        <service id="Setono\SyliusCMSPlugin\Homepage\CMSHomepageChannels" class="Setono\SyliusCMSPlugin\Homepage\CMSHomepageChannels">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\HomepageRepositoryInterface"/>
            <argument type="service" id="sylius.repository.channel"/>
        </service>
    </services>
</container>
