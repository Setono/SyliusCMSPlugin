<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!--
        Finds an entry's problems, of every kind, as they are now, which its overview page gets through
        cms_admin_entry_problems() (Twig\EntryOverviewRuntime). RegisterProblemKindsPass hands it the kinds
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\ProblemFinder" class="Setono\SyliusCMSPlugin\Problem\ProblemFinder">
            <argument type="collection"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\WorkingCopyProviderInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Problem\ProblemFinderInterface" alias="Setono\SyliusCMSPlugin\Problem\ProblemFinder"/>

        <!--
        Finds the problems of presets, which aren't entries, once per request: the Overview's Needs attention lists them
        and the Content badge counts them. A kind is a service tagged setono_sylius_cms.preset_problem_kind
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\PresetProblemFinder" class="Setono\SyliusCMSPlugin\Problem\PresetProblemFinder">
            <argument type="service" id="Setono\SyliusCMSPlugin\Preset\PresetProviderInterface"/>
            <argument type="tagged_iterator" tag="setono_sylius_cms.preset_problem_kind"/>

            <tag name="kernel.reset" method="reset"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Problem\PresetProblemFinderInterface" alias="Setono\SyliusCMSPlugin\Problem\PresetProblemFinder"/>

        <service id="Setono\SyliusCMSPlugin\Problem\Kind\PresetWithRemovedBlockTypes" class="Setono\SyliusCMSPlugin\Problem\Kind\PresetWithRemovedBlockTypes">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>

            <tag name="setono_sylius_cms.preset_problem_kind"/>
        </service>

        <!--
        The errors and warnings of each entry, counted when the entry is written and stored with it, which the lists'
        marker, their Needs attention filter and the Content badge read. RegisterProblemKindsPass hands the updater
        the kinds whose problems are stored, and the fingerprint their classes. The working copies it reads go on to the
        other counts stored with each entry: the locales it's complete in
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\ProblemCountUpdater" class="Setono\SyliusCMSPlugin\Problem\ProblemCountUpdater">
            <argument type="collection"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\WorkingCopyProviderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\ProblemCountsQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Problem\ProblemCountFingerprintInterface"/>
            <argument type="collection">
                <argument type="service" id="Setono\SyliusCMSPlugin\Translation\CompletenessCounter"/>
            </argument>
            <argument type="service" id="logger"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Problem\ProblemCountUpdaterInterface" alias="Setono\SyliusCMSPlugin\Problem\ProblemCountUpdater"/>

        <service id="Setono\SyliusCMSPlugin\Problem\ProblemCountFingerprint" class="Setono\SyliusCMSPlugin\Problem\ProblemCountFingerprint">
            <argument type="collection"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\LayoutRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SourceRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SlotRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContextKeyRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BindablePropertyRegistryInterface"/>

            <tag name="kernel.reset" method="reset"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Problem\ProblemCountFingerprintInterface" alias="Setono\SyliusCMSPlugin\Problem\ProblemCountFingerprint"/>

        <!-- RegisterProblemKindsPass hands it the time-dependent kinds -->
        <service id="Setono\SyliusCMSPlugin\Problem\ProblemCountProvider" class="Setono\SyliusCMSPlugin\Problem\ProblemCountProvider">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\ProblemCountsQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Problem\ProblemCountUpdaterInterface"/>
            <argument type="collection"/>
            <argument type="service" id="clock"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>

            <tag name="kernel.reset" method="reset"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Problem\ProblemCountProviderInterface" alias="Setono\SyliusCMSPlugin\Problem\ProblemCountProvider"/>

        <!--
        Has the entries a flush writes counted again once it's done, and those that reference what it writes: of what
        entries refer to by a field, such as a product's code, only a delete or a change of the field. RegisterProblemKindsPass
        hands it the kinds about references, what they reference and the fields they refer to it by. preUpdate gives it
        an update's change set
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\ProblemCountListener" class="Setono\SyliusCMSPlugin\Problem\ProblemCountListener">
            <argument type="service" id="Setono\SyliusCMSPlugin\Problem\ProblemCountUpdaterInterface"/>
            <argument type="collection"/>
            <argument type="collection"/>
            <argument type="collection"/>

            <tag name="doctrine.event_listener" event="onFlush"/>
            <tag name="doctrine.event_listener" event="preUpdate"/>
            <tag name="doctrine.event_listener" event="postFlush"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <!--
        The problem kinds. A kind is a service tagged setono_sylius_cms.problem_kind, which autoconfiguration adds to a
        ProblemKindInterface. setono:cms:lint reports the kinds whose tag has lint="true"
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\UnknownBlockType" class="Setono\SyliusCMSPlugin\Problem\Kind\UnknownBlockType">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind" lint="true"/>
        </service>

        <!-- A block's condition of a kind a project removed, on purpose or not: a warning in the admin, so lint leaves it out -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\UnknownConditionKind" class="Setono\SyliusCMSPlugin\Problem\Kind\UnknownConditionKind">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\TreeValues"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!-- A list filled by a source the code no longer has, which lists nothing -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\UnknownSource" class="Setono\SyliusCMSPlugin\Problem\Kind\UnknownSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\TreeValues"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SourceRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind" lint="true"/>
        </service>

        <!-- A field bound to a property the code no longer has, which shows its fallback -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\UnknownBindableProperty" class="Setono\SyliusCMSPlugin\Problem\Kind\UnknownBindableProperty">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\TreeValues"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Binding\StoredValueBindings"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BindablePropertyRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind" lint="true"/>
        </service>

        <!-- A layout a project removed or turned off on purpose: a warning in the admin, so lint leaves it out -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\RemovedLayout" class="Setono\SyliusCMSPlugin\Problem\Kind\RemovedLayout">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\LayoutRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!--
        A category whose URL is its archive, but whose tree no longer holds an Entries block to list its entries: a warning
        in the admin, as editors may remove it on purpose, so lint leaves it out
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\CategoryArchiveWithoutEntries" class="Setono\SyliusCMSPlugin\Problem\Kind\CategoryArchiveWithoutEntries">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Collection\Collections"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!-- A placement in a slot a project removed, on purpose or not: a warning in the admin, so lint leaves it out -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\RemovedSlot" class="Setono\SyliusCMSPlugin\Problem\Kind\RemovedSlot">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\PlacementRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SlotRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!--
        A page-scope condition of a kind a project removed, or that needs context its slot no longer provides: a warning
        in the admin, so lint leaves it out
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\PageScopeMismatch" class="Setono\SyliusCMSPlugin\Problem\Kind\PageScopeMismatch">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\PlacementRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SlotRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContextKeyRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!--
        A capped slot without a catch-all placement, on each snippet placed in it: a warning in the admin, so lint leaves
        it out
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\CappedSlotWithoutCatchAll" class="Setono\SyliusCMSPlugin\Problem\Kind\CappedSlotWithoutCatchAll">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\PlacementRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SlotRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!--
        A placement on Sylius's own homepage in a channel whose homepage is a CMS page: a warning in the admin, so lint
        leaves it out
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\PlacementHiddenByHomepage" class="Setono\SyliusCMSPlugin\Problem\Kind\PlacementHiddenByHomepage">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\PlacementRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SlotRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Homepage\CMSHomepageChannels"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!--
        A page that's the homepage of a channel it has left, where the store's own homepage shows: a warning in the
        admin, so lint leaves it out
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\HomepageNotInChannel" class="Setono\SyliusCMSPlugin\Problem\Kind\HomepageNotInChannel">
            <argument type="service" id="sylius.repository.channel"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!-- A snippet that needs a context key a project removed: a warning in the admin, so lint leaves it out -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\RemovedContextKey" class="Setono\SyliusCMSPlugin\Problem\Kind\RemovedContextKey">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContextKeyRegistryInterface"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Problem\Kind\MisfitValue" class="Setono\SyliusCMSPlugin\Problem\Kind\MisfitValue">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\TreeValues"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\StoredValueFit"/>

            <tag name="setono_sylius_cms.problem_kind" lint="true"/>
        </service>

        <!-- A broken reference, which setono:cms:lint reports -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\DeletedCustomerGroup" class="Setono\SyliusCMSPlugin\Problem\Kind\DeletedCustomerGroup">
            <argument type="service" id="sylius.repository.customer_group"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>

            <tag name="setono_sylius_cms.problem_kind" lint="true"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <!-- Which references no longer resolve, and which entries may refer to a record, for the broken reference kinds -->
        <service id="Setono\SyliusCMSPlugin\Problem\BrokenReferences" class="Setono\SyliusCMSPlugin\Problem\BrokenReferences">
            <argument type="tagged_locator" tag="setono_sylius_cms.reference_type_loader" index-by="type"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>
        </service>

        <!-- A reference in a field to a record that was deleted, such as a media item, which setono:cms:lint reports -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\BrokenReference" class="Setono\SyliusCMSPlugin\Problem\Kind\BrokenReference">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\ReferenceFinder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\LayoutRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Problem\BrokenReferences"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeFields"/>

            <tag name="setono_sylius_cms.problem_kind" lint="true"/>
        </service>

        <!--
        A condition naming a channel or locale the store no longer has, or with a parameter referring to a deleted record,
        such as a product, which setono:cms:lint reports
        -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\BrokenConditionReference" class="Setono\SyliusCMSPlugin\Problem\Kind\BrokenConditionReference">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\TreeValues"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ConditionKindRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Field\FieldHandlerLocator"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Problem\BrokenReferences"/>
            <argument type="service" id="sylius.repository.channel"/>
            <argument type="service" id="sylius.repository.locale"/>

            <tag name="setono_sylius_cms.problem_kind" lint="true"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <!-- A snippet that would render inside itself, which setono:cms:lint reports -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\SnippetInsideItself" class="Setono\SyliusCMSPlugin\Problem\Kind\SnippetInsideItself">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\SnippetCycles"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>

            <tag name="setono_sylius_cms.problem_kind" lint="true"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Problem\Kind\UrlTakenByRoute" class="Setono\SyliusCMSPlugin\Problem\Kind\UrlTakenByRoute">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Routing\TakenUrlFinderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <!-- A scheduled publish that's overdue, or failed: errors of the admin's, not of the content, so lint leaves them out -->
        <service id="Setono\SyliusCMSPlugin\Problem\Kind\ScheduledPublishOverdue" class="Setono\SyliusCMSPlugin\Problem\Kind\ScheduledPublishOverdue">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\ScheduledPublishRepositoryInterface"/>
            <argument type="service" id="clock"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\SchedulingTimeZone"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Problem\Kind\ScheduledPublishFailed" class="Setono\SyliusCMSPlugin\Problem\Kind\ScheduledPublishFailed">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\ScheduledPublishRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\SchedulingTimeZone"/>

            <tag name="setono_sylius_cms.problem_kind"/>
        </service>
    </services>
</container>
