<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_cms.twig.extractor.section"
                 class="Setono\SyliusCMSPlugin\Twig\Extractor\SectionExtractor">
            <argument type="service" id="twig"/>
        </service>

        <service id="setono_sylius_cms.twig.loader.template"
                 class="Setono\SyliusCMSPlugin\Twig\Loader\TemplateLoader">
            <argument type="service" id="setono_sylius_cms.repository.template"/>

            <tag name="twig.loader"/>
        </service>

        <service id="setono_sylius_cms.twig.extension"
                 class="Setono\SyliusCMSPlugin\Twig\Extension\Extension">
            <tag name="twig.extension"/>
        </service>

        <service id="setono_sylius_cms.twig.runtime"
                 class="Setono\SyliusCMSPlugin\Twig\Extension\Runtime">
            <argument type="service" id="router"/>
            <argument type="service" id="setono_sylius_cms.generator.page.preview_link"/>
            <argument type="service" id="setono_sylius_cms.previewer.composite"/>
            <argument type="service" id="sylius.context.channel"/>
            <argument type="service" id="sylius.context.locale"/>
            <argument type="service" id="setono_sylius_cms.generator.element_identifier"/>
            <argument type="service" id="event_dispatcher"/>

            <call method="setLogger">
                <argument type="service" id="logger"/>
            </call>

            <tag name="twig.runtime"/>
        </service>

        <!-- Element loaders -->
        <service id="setono_sylius_cms.twig.loader.element_loader.asset"
                 class="Setono\SyliusCMSPlugin\Twig\Loader\GenericElementLoader">
            <argument type="service" id="setono_sylius_cms.repository.asset"/>
            <argument type="service" id="setono_sylius_cms.generator.twig.composite"/>
            <argument>asset</argument>

            <tag name="twig.loader"/>
        </service>

        <service id="setono_sylius_cms.twig.loader.element_loader.block"
                 class="Setono\SyliusCMSPlugin\Twig\Loader\GenericElementLoader">
            <argument type="service" id="setono_sylius_cms.repository.block"/>
            <argument type="service" id="setono_sylius_cms.generator.twig.composite"/>
            <argument>block</argument>

            <tag name="twig.loader"/>
        </service>

        <service id="setono_sylius_cms.twig.loader.element_loader.carousel"
                 class="Setono\SyliusCMSPlugin\Twig\Loader\GenericElementLoader">
            <argument type="service" id="setono_sylius_cms.repository.carousel"/>
            <argument type="service" id="setono_sylius_cms.generator.twig.composite"/>
            <argument>carousel</argument>

            <tag name="twig.loader"/>
        </service>

        <service id="setono_sylius_cms.twig.loader.element_loader.page"
                 class="Setono\SyliusCMSPlugin\Twig\Loader\GenericElementLoader">
            <argument type="service" id="setono_sylius_cms.repository.page"/>
            <argument type="service" id="setono_sylius_cms.generator.twig.composite"/>
            <argument>page</argument>

            <tag name="twig.loader"/>
        </service>
    </services>
</container>
