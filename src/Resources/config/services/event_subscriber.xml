<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_cms.event_subscriber.add_toolbar"
                 class="Setono\SyliusCMSPlugin\EventSubscriber\AddToolbarSubscriber">
            <argument type="service" id="twig"/>
            <argument type="service" id="setono_sylius_cms.stack.element"/>
            <argument type="service" id="sylius.section_resolver.uri_based_section_resolver"/>
            <argument type="service" id="security.authorization_checker"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="setono_sylius_cms.event_subscriber.remove_asset_file"
                 class="Setono\SyliusCMSPlugin\EventSubscriber\RemoveAssetFileSubscriber">
            <argument type="service">
                <service class="Gaufrette\Filesystem">
                    <argument>%setono_sylius_cms.asset_adapter%</argument>
                    <factory service="knp_gaufrette.filesystem_map" method="get" />
                </service>
            </argument>
            <argument type="service" id="liip_imagine.cache.manager"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="setono_sylius_cms.event_subscriber.resource_delete"
                 class="Setono\SyliusCMSPlugin\EventSubscriber\ResourceDeleteSubscriber">
            <argument type="service" id="router" />
            <argument type="service" id="session" />
            <argument type="collection">
                <argument>setono_sylius_cms_admin_block_bulk_delete</argument>
                <argument>setono_sylius_cms_admin_block_delete</argument>

                <argument>setono_sylius_cms_admin_carousel_bulk_delete</argument>
                <argument>setono_sylius_cms_admin_carousel_delete</argument>

                <argument>setono_sylius_cms_admin_page_bulk_delete</argument>
                <argument>setono_sylius_cms_admin_page_delete</argument>

                <argument>setono_sylius_cms_admin_view_bulk_delete</argument>
                <argument>setono_sylius_cms_admin_view_delete</argument>
            </argument>

            <tag name="kernel.event_subscriber" event="kernel.exception" />
        </service>
    </services>
</container>
