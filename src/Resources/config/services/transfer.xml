<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <!-- Transfer: exports of entries, editor presets and media items (docs/spec/transfer.md) -->
    <services>
        <service id="Setono\SyliusCMSPlugin\Transfer\PublishedContent" class="Setono\SyliusCMSPlugin\Transfer\PublishedContent">
            <argument type="service" id="Setono\SyliusCMSPlugin\Upgrade\StoredDataUpgraderInterface"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\ExportPlanner" class="Setono\SyliusCMSPlugin\Transfer\ExportPlanner">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>
            <argument type="service" id="setono_sylius_cms.repository.editor_preset"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\MediaItemRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\MediaFolderRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\PublishedContent"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\ReferenceFinder"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Transfer\ExportPlannerInterface" alias="Setono\SyliusCMSPlugin\Transfer\ExportPlanner"/>

        <service id="Setono\SyliusCMSPlugin\Transfer\Exporter" class="Setono\SyliusCMSPlugin\Transfer\Exporter">
            <argument type="service" id="Setono\SyliusCMSPlugin\EntryFormat\EntryNormalizer"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\PublishedContent"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\PlacementRepositoryInterface"/>
            <argument type="service" id="setono_sylius_cms.storage"/>
            <argument type="service" id="clock"/>
            <argument>%setono_sylius_cms.plugin_version%</argument>
        </service>
        <service id="Setono\SyliusCMSPlugin\Transfer\ExporterInterface" alias="Setono\SyliusCMSPlugin\Transfer\Exporter"/>

        <!-- Imports: read, plan, apply all or nothing (docs/spec/transfer.md#what-an-import-does) -->
        <!-- Every file of an export goes through the checks an upload does (docs/spec/transfer.md#media-files) -->
        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImportedFileChecker" class="Setono\SyliusCMSPlugin\Transfer\Import\ImportedFileChecker">
            <argument type="service" id="Setono\SyliusCMSPlugin\Media\MediaFileCheckerInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Media\UploadLimit"/>
            <argument>%setono_sylius_cms.transfer.max_file_size%</argument>
        </service>

        <!-- Opens an export folder or zip; a zip unpacks to no more than transfer.max_unpacked_size -->
        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ExportSources" class="Setono\SyliusCMSPlugin\Transfer\Import\ExportSources">
            <argument>%setono_sylius_cms.transfer.max_unpacked_size%</argument>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ExportReader" class="Setono\SyliusCMSPlugin\Transfer\Import\ExportReader">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\LayoutRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\BlockTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Upgrade\StoredDataUpgraderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preset\PresetUpgrader"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\EntryFormat\EntryDenormalizer"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImportedFileChecker"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\TargetRecords" class="Setono\SyliusCMSPlugin\Transfer\Import\TargetRecords">
            <argument type="service" id="Setono\SyliusCMSPlugin\EntryFormat\EntryNormalizer"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\PublishedContent"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\WorkingCopyManagerInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\ScheduledPublishRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\PlacementRepositoryInterface"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\UnresolvedReferences" class="Setono\SyliusCMSPlugin\Transfer\Import\UnresolvedReferences">
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\ReferenceFinder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Condition\ConditionMatcher"/>
            <argument type="tagged_locator" tag="setono_sylius_cms.reference_type_loader" index-by="type"/>
            <argument type="service" id="sylius.repository.channel"/>
            <argument type="service" id="sylius.repository.customer_group"/>
            <argument type="service" id="sylius.repository.locale"/>
            <argument type="service" id="sylius.repository.product_attribute"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImportPlanner" class="Setono\SyliusCMSPlugin\Transfer\Import\ImportPlanner">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>
            <argument type="service" id="setono_sylius_cms.repository.editor_preset"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\TargetRecords"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Routing\UrlClashFinderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Localization\Availability"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Validation\EmbedCodeValidator"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Upgrade\StoredDataUpgraderInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\HomepageRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\UnresolvedReferences"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Tree\ReferenceFinder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\MediaItemRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\MediaFolderRepositoryInterface"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImportPlannerInterface" alias="Setono\SyliusCMSPlugin\Transfer\Import\ImportPlanner"/>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImportedPlacements" class="Setono\SyliusCMSPlugin\Transfer\Import\ImportedPlacements">
            <argument type="service" id="setono_sylius_cms.manager.placement"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\PlacementRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Factory\PlacementFactoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\EditRecorder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Event\AfterCommitDispatcher"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImportApplier" class="Setono\SyliusCMSPlugin\Transfer\Import\ImportApplier">
            <argument type="service" id="setono_sylius_cms.manager.entry"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\EntryRepositoryInterface"/>
            <argument type="service" id="setono_sylius_cms.entry_factories"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\EntryFormat\EntryDenormalizer"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\EditRecorder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\AutosaveInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\WorkingCopyManagerInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\PublishSchedulerInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\ScheduledPublishRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\EntrySettingsSaverInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImportedPlacements"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Preset\EditorPresetSaverInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Validation\EntryValidatorInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Publishing\EntryPublisherInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\TargetRecords"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Event\AfterCommitDispatcher"/>
        </service>

        <!-- Media come first, their files stored once the plan is complete (docs/spec/transfer.md#what-an-import-does) -->
        <service id="Setono\SyliusCMSPlugin\Transfer\Import\MediaApplier" class="Setono\SyliusCMSPlugin\Transfer\Import\MediaApplier">
            <argument type="service" id="setono_sylius_cms.manager.media_item"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\MediaItemRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\MediaFolderRepositoryInterface"/>
            <argument type="service" id="setono_sylius_cms.factory.media_item"/>
            <argument type="service" id="setono_sylius_cms.factory.media_folder"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Event\AfterCommitDispatcher"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Event\AfterCommitMessageBus"/>
            <argument type="service" id="clock"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Media\GracePeriod"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\Importer" class="Setono\SyliusCMSPlugin\Transfer\Import\Importer">
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ExportReader"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImportPlannerInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\MediaApplier"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImportApplier"/>
            <argument type="service" id="setono_sylius_cms.manager.entry"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Event\AfterCommitDispatcher"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Event\AfterCommitMessageBus"/>
            <argument type="service" id="setono_sylius_cms.storage"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImporterInterface" alias="Setono\SyliusCMSPlugin\Transfer\Import\Importer"/>

        <!--
        Imports started in the admin run on the Messenger worker, from the uploaded zip kept in the media storage
        (docs/spec/transfer.md#who-runs-it)
        -->
        <service id="Setono\SyliusCMSPlugin\Transfer\Import\UploadedExports" class="Setono\SyliusCMSPlugin\Transfer\Import\UploadedExports">
            <argument type="service" id="setono_sylius_cms.transfer_storage"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImportResultNormalizer" class="Setono\SyliusCMSPlugin\Transfer\Import\ImportResultNormalizer"/>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImportQueue" class="Setono\SyliusCMSPlugin\Transfer\Import\ImportQueue">
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\UploadedExports"/>
            <argument type="service" id="setono_sylius_cms.factory.import"/>
            <argument type="service" id="setono_sylius_cms.manager.import"/>
            <argument type="service" id="sylius.event_bus"/>
            <argument type="service" id="clock"/>
        </service>
        <service id="Setono\SyliusCMSPlugin\Transfer\Import\ImportQueueInterface" alias="Setono\SyliusCMSPlugin\Transfer\Import\ImportQueue"/>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\RunImportHandler" class="Setono\SyliusCMSPlugin\Transfer\Import\RunImportHandler">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\ImportRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImporterInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImportResultNormalizer"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\UploadedExports"/>
            <argument type="service" id="setono_sylius_cms.manager.import"/>
            <argument type="service" id="clock"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ExportSources"/>

            <tag name="messenger.message_handler" handles="Setono\SyliusCMSPlugin\Transfer\Import\RunImport"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Transfer\Import\AbandonImportHandler" class="Setono\SyliusCMSPlugin\Transfer\Import\AbandonImportHandler">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\ImportRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImportQueueInterface"/>

            <tag name="messenger.message_handler" handles="Setono\SyliusCMSPlugin\Transfer\Import\AbandonImport"/>
        </service>

        <!-- Fails an import once Messenger gives up retrying its RunImport, and deletes its zip -->
        <service id="Setono\SyliusCMSPlugin\Transfer\Import\FailedImportListener" class="Setono\SyliusCMSPlugin\Transfer\Import\FailedImportListener">
            <argument type="service" id="Setono\SyliusCMSPlugin\Repository\ImportRepositoryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImportQueueInterface"/>
            <argument type="service" id="setono_sylius_cms.manager.import"/>
            <argument type="service" id="doctrine"/>

            <tag name="kernel.event_listener" event="Symfony\Component\Messenger\Event\WorkerMessageFailedEvent"/>
        </service>

        <!-- The Sylius fixture setono_cms_import loads exports as demo and test data (docs/spec/extending.md#fixture) -->
        <service id="Setono\SyliusCMSPlugin\Fixture\ImportFixture" class="Setono\SyliusCMSPlugin\Fixture\ImportFixture">
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ImporterInterface"/>
            <argument type="service" id="translator"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Transfer\Import\ExportSources"/>

            <tag name="sylius_fixtures.fixture"/>
        </service>
    </services>
</container>
