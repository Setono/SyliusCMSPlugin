<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <parameter type="collection" key="setono_sylius_cms.form.type.asset.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection" key="setono_sylius_cms.form.type.block.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection"
                   key="setono_sylius_cms.form.type.block_translation.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection" key="setono_sylius_cms.form.type.page.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection" key="setono_sylius_cms.form.type.page_translation.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection" key="setono_sylius_cms.form.type.template.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection" key="setono_sylius_cms.form.type.view.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection" key="setono_sylius_cms.form.type.carousel.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection" key="setono_sylius_cms.form.type.carousel_block.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>
    </parameters>
    <services>
        <!-- Asset -->
        <service id="setono_sylius_cms.form.type.asset"
                 class="Setono\SyliusCMSPlugin\Form\Type\AssetType">
            <argument type="service" id="setono_sylius_cms.uploader.asset"/>
            <argument>%setono_sylius_cms.model.asset.class%</argument>
            <argument>%setono_sylius_cms.form.type.asset.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <!-- Block -->
        <service id="setono_sylius_cms.form.type.block"
                 class="Setono\SyliusCMSPlugin\Form\Type\BlockType">
            <argument type="service" id="setono_editorjs.parser"/>
            <argument type="service" id="setono_editorjs.renderer"/>
            <argument type="service" id="request_stack"/>
            <argument>%setono_sylius_cms.model.block.class%</argument>
            <argument>%setono_sylius_cms.form.type.block.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms_form.type.block_autocomplete_choice"
                 class="Setono\SyliusCMSPlugin\Form\Type\BlockAutocompleteChoiceType">
            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.block_translation"
                 class="Setono\SyliusCMSPlugin\Form\Type\BlockTranslationType">
            <argument type="service" id="setono_editorjs.parser"/>
            <argument type="service" id="setono_editorjs.renderer"/>
            <argument>%setono_sylius_cms.model.block_translation.class%</argument>
            <argument>%setono_sylius_cms.form.type.block_translation.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <!-- Page -->
        <service id="setono_sylius_cms.form.type.page"
                 class="Setono\SyliusCMSPlugin\Form\Type\PageType">
            <argument>%setono_sylius_cms.model.page.class%</argument>
            <argument>%setono_sylius_cms.form.type.page.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.page_translation"
                 class="Setono\SyliusCMSPlugin\Form\Type\PageTranslationType">
            <argument>%setono_sylius_cms.model.page_translation.class%</argument>
            <argument>%setono_sylius_cms.form.type.page_translation.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <!-- Template -->
        <service id="setono_sylius_cms.form.type.template"
                 class="Setono\SyliusCMSPlugin\Form\Type\TemplateType">
            <argument>%setono_sylius_cms.model.template.class%</argument>
            <argument>%setono_sylius_cms.form.type.template.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.template_choice"
                 class="Setono\SyliusCMSPlugin\Form\Type\TemplateChoiceType">
            <argument type="service" id="setono_sylius_cms.template.registry"/>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.view"
                 class="Setono\SyliusCMSPlugin\Form\Type\ViewType">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="setono_sylius_cms.form.data_mapper.view_sections"/>
            <argument type="service" id="setono_sylius_cms.template.registry"/>
            <argument type="service" id="setono_sylius_cms.template.metadata_extractor"/>
            <argument>%setono_sylius_cms.model.view.class%</argument>
            <argument>%setono_sylius_cms.form.type.view.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.view_choice"
                 class="Setono\SyliusCMSPlugin\Form\Type\ViewChoiceType">
            <argument type="service" id="setono_sylius_cms.repository.view"/>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.view_sections"
                 class="Setono\SyliusCMSPlugin\Form\Type\ViewSectionsType">
            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.view_section"
                 class="Setono\SyliusCMSPlugin\Form\Type\ViewSectionType">
            <tag name="form.type"/>
        </service>

        <!-- Carousel -->
        <service id="setono_sylius_cms.form.type.carousel"
                 class="Setono\SyliusCMSPlugin\Form\Type\CarouselType">
            <argument type="service" id="request_stack"/>
            <argument>%setono_sylius_cms.model.carousel.class%</argument>
            <argument>%setono_sylius_cms.form.type.carousel.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.carousel_block"
                 class="Setono\SyliusCMSPlugin\Form\Type\CarouselBlockType">
            <argument>%setono_sylius_cms.model.carousel_block.class%</argument>
            <argument>%setono_sylius_cms.form.type.carousel_block.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.carousel_configuration"
                 class="Setono\SyliusCMSPlugin\Form\Type\CarouselConfigurationType">
            <tag name="form.type"/>
        </service>

        <!-- Data mapper -->
        <service id="setono_sylius_cms.form.data_mapper.view_sections"
                 class="Setono\SyliusCMSPlugin\Form\DataMapper\ViewSectionsDataMapper">
            <argument type="service" id="property_accessor"/>
            <argument type="service" id="setono_sylius_cms.template.registry"/>
            <argument type="service" id="setono_sylius_cms.template.metadata_extractor"/>
            <argument type="service" id="setono_sylius_cms.factory.view_block"/>
        </service>
    </services>
</container>
