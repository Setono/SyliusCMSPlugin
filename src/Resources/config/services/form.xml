<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <parameter type="collection" key="setono_sylius_cms.form.type.block.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection"
                   key="setono_sylius_cms.form.type.block_translation.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection" key="setono_sylius_cms.form.type.page.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection"
                   key="setono_sylius_cms.form.type.page_translation.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection"
                   key="setono_sylius_cms.form.type.template.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter type="collection"
                   key="setono_sylius_cms.form.type.view.validation_groups">
            <parameter>setono_sylius_cms</parameter>
        </parameter>

        <parameter key="setono_sylius_cms.form.model.cms_view.view.class">Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSViewModel</parameter>
        <parameter key="setono_sylius_cms.form.model.cms_view.section.class">Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSSectionModel</parameter>
        <parameter key="setono_sylius_cms.form.model.cms_view.block.class">Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSBlockModel</parameter>
    </parameters>
    <services>
        <service id="setono_sylius_cms.form.type.block"
                 class="Setono\SyliusCMSPlugin\Form\Type\BlockType">
            <argument type="service" id="setono_editorjs.parser"/>
            <argument type="service" id="setono_editorjs.renderer"/>
            <argument type="service" id="request_stack"/>
            <argument>%setono_sylius_cms.model.block.class%</argument>
            <argument>%setono_sylius_cms.form.type.block.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.block_translation"
                 class="Setono\SyliusCMSPlugin\Form\Type\BlockTranslationType">
            <argument type="service" id="setono_editorjs.parser"/>
            <argument type="service" id="setono_editorjs.renderer"/>
            <argument>%setono_sylius_cms.model.block_translation.class%</argument>
            <argument>%setono_sylius_cms.form.type.block_translation.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms_form.type.block_autocomplete_choice"
                 class="Setono\SyliusCMSPlugin\Form\Type\BlockAutocompleteChoiceType">
            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.page"
                 class="Setono\SyliusCMSPlugin\Form\Type\PageType">
            <argument>%setono_sylius_cms.model.page.class%</argument>
            <argument>%setono_sylius_cms.form.type.page.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.page_translation"
                 class="Setono\SyliusCMSPlugin\Form\Type\PageTranslationType">
            <argument>%setono_sylius_cms.model.page_translation.class%</argument>
            <argument>%setono_sylius_cms.form.type.page_translation.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.template"
                 class="Setono\SyliusCMSPlugin\Form\Type\TemplateType">
            <argument>%setono_sylius_cms.model.template.class%</argument>
            <argument>%setono_sylius_cms.form.type.template.validation_groups%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.template_choice"
                 class="Setono\SyliusCMSPlugin\Form\Type\TemplateChoiceType">
            <argument type="service" id="setono_sylius_cms.template.registry"/>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.type.view_choice"
                 class="Setono\SyliusCMSPlugin\Form\Type\ViewChoiceType">
            <argument type="service" id="setono_sylius_cms.repository.view"/>

            <tag name="form.type"/>
        </service>

        <!-- MODEL FACTORIES -->
        <service id="setono_sylius_cms.form.model.factory.cms_view.view"
                 class="Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSViewModelFactory" public="true">
            <argument>%setono_sylius_cms.form.model.cms_view.view.class%</argument>
            <argument type="service" id="setono_sylius_cms.template.metadata_extractor" />
            <argument type="service" id="setono_sylius_cms.repository.template" />
            <argument type="service" id="setono_sylius_cms.form.model.factory.cms_view.section" />
        </service>
        <service id="Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSViewModelFactoryInterface"
                 alias="setono_sylius_cms.form.model.factory.cms_view.view" />

        <service id="setono_sylius_cms.form.model.factory.cms_view.section"
                 class="Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSSectionModelFactory">
            <argument>%setono_sylius_cms.form.model.cms_view.section.class%</argument>
            <argument type="service" id="setono_sylius_cms.form.model.factory.cms_view.block" />
        </service>
        <service id="Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSSectionModelFactoryInterface"
                 alias="setono_sylius_cms.form.model.factory.cms_view.section" />

        <service id="setono_sylius_cms.form.model.factory.cms_view.block"
                 class="Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSBlockModelFactory">
            <argument>%setono_sylius_cms.form.model.cms_view.block.class%</argument>
        </service>
        <service id="Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSBlockModelFactoryInterface"
                 alias="setono_sylius_cms.form.model.factory.cms_view.block" />

        <!-- MODEL MAPPERS -->
        <service id="setono_sylius_cms.form.model.mapper.cms_view.view"
                 class="Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSViewModelToViewMapper" public="true">
            <argument type="service" id="setono_sylius_cms.factory.view_block" />
        </service>
        <service id="Setono\SyliusCMSPlugin\Form\Model\CMSView\CMSViewModelToViewMapperInterface"
                 alias="setono_sylius_cms.form.model.mapper.cms_view.view" />

        <!-- MODEL TYPES -->
        <service id="setono_sylius_cms.form.model.type.cms_view.view"
                 class="Setono\SyliusCMSPlugin\Form\Type\CMSView\CMSViewModelType">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="setono_sylius_cms.template.metadata_extractor"/>
            <argument type="service" id="setono_sylius_cms.repository.template"/>
            <argument type="service" id="setono_sylius_cms.form.model.factory.cms_view.section"/>
            <argument>%setono_sylius_cms.form.model.cms_view.view.class%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.model.type.cms_view.section"
                 class="Setono\SyliusCMSPlugin\Form\Type\CMSView\CMSSectionModelType">
            <argument>%setono_sylius_cms.form.model.cms_view.section.class%</argument>

            <tag name="form.type"/>
        </service>

        <service id="setono_sylius_cms.form.model.type.cms_view.block"
                 class="Setono\SyliusCMSPlugin\Form\Type\CMSView\CMSBlockModelType">
            <argument>%setono_sylius_cms.form.model.cms_view.block.class%</argument>
            <argument>%setono_sylius_cms.model.block.class%</argument>

            <tag name="form.type"/>
        </service>
    </services>
</container>
