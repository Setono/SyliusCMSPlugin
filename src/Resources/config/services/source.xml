<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Resolves what list fields store when a source fills them: the references of its parameters, its adapter and what publish checks -->
        <service id="Setono\SyliusCMSPlugin\Source\SourceResolver" class="Setono\SyliusCMSPlugin\Source\SourceResolver">
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\SourceRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Rendering\ParamsHydrator"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Field\FieldHandlerLocator"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Localization\FallbackValues"/>
            <argument type="service" id="translator"/>
        </service>

        <!-- Narrows a visible-products query to the products in a taxon, or in it or below it, for the product sources with a taxon parameter -->
        <service id="Setono\SyliusCMSPlugin\Source\Product\TaxonFilter" class="Setono\SyliusCMSPlugin\Source\Product\TaxonFilter">
            <argument>%sylius.model.product_taxon.class%</argument>
        </service>

        <!-- What the Associations source's association type is picked from, as a Choice field's choices provider -->
        <service id="Setono\SyliusCMSPlugin\Source\Product\ProductAssociationTypeChoicesProvider" class="Setono\SyliusCMSPlugin\Source\Product\ProductAssociationTypeChoicesProvider">
            <argument type="service" id="sylius.repository.product_association_type"/>

            <tag name="setono_sylius_cms.choices_provider"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <!-- What From a collection's collection is picked from, as a Choice field's choices provider -->
        <service id="Setono\SyliusCMSPlugin\Source\Entry\CollectionChoicesProvider" class="Setono\SyliusCMSPlugin\Source\Entry\CollectionChoicesProvider">
            <argument type="service" id="Setono\SyliusCMSPlugin\Collection\Collections"/>
            <argument type="service" id="translator"/>

            <tag name="setono_sylius_cms.choices_provider"/>
        </service>

        <!--
        The shipped sources. A source is a service carrying #[AsSource], which autoconfiguration tags
        setono_sylius_cms.source, and RegisterSourcesPass hands to the registry by code. The builder offers them by their
        tag's priority, so the shipped ones come first, in this order, and then a project's
        -->
        <service id="Setono\SyliusCMSPlugin\Source\Product\ProductsInTaxonSource" class="Setono\SyliusCMSPlugin\Source\Product\ProductsInTaxonSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleProductsQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Source\Product\TaxonFilter"/>
            <argument>%sylius.model.channel_pricing.class%</argument>

            <tag name="setono_sylius_cms.source" priority="60"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Source\Product\BestsellersSource" class="Setono\SyliusCMSPlugin\Source\Product\BestsellersSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleProductsQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Source\Product\TaxonFilter"/>
            <argument>%setono_sylius_cms.model.bestseller_score.class%</argument>

            <tag name="setono_sylius_cms.source" priority="50"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Source\Product\NewestProductsSource" class="Setono\SyliusCMSPlugin\Source\Product\NewestProductsSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleProductsQueryInterface"/>

            <tag name="setono_sylius_cms.source" priority="40"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Source\Product\ProductAssociationsSource" class="Setono\SyliusCMSPlugin\Source\Product\ProductAssociationsSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleProductsQueryInterface"/>
            <argument>%sylius.model.product_association.class%</argument>

            <tag name="setono_sylius_cms.source" priority="30"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Source\Product\SameTaxonProductsSource" class="Setono\SyliusCMSPlugin\Source\Product\SameTaxonProductsSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleProductsQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Source\Product\TaxonFilter"/>

            <tag name="setono_sylius_cms.source" priority="20"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Source\Taxon\TaxonChildrenSource" class="Setono\SyliusCMSPlugin\Source\Taxon\TaxonChildrenSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleTaxonsQueryInterface"/>

            <tag name="setono_sylius_cms.source" priority="10"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Source\Entry\EntriesFromCollectionSource" class="Setono\SyliusCMSPlugin\Source\Entry\EntriesFromCollectionSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleEntriesQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Collection\IndexedFields"/>

            <tag name="setono_sylius_cms.source" priority="9"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Source\Entry\EntriesInThisCategorySource" class="Setono\SyliusCMSPlugin\Source\Entry\EntriesInThisCategorySource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleEntriesQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Collection\Collections"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Collection\IndexedFields"/>

            <tag name="setono_sylius_cms.source" priority="8"/>
        </service>

        <service id="Setono\SyliusCMSPlugin\Source\Entry\RelatedEntriesSource" class="Setono\SyliusCMSPlugin\Source\Entry\RelatedEntriesSource">
            <argument type="service" id="Setono\SyliusCMSPlugin\Query\VisibleEntriesQueryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Registry\ContentTypeRegistryInterface"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Collection\Collections"/>
            <argument type="service" id="Setono\SyliusCMSPlugin\Collection\IndexedFields"/>

            <tag name="setono_sylius_cms.source" priority="7"/>
        </service>
    </services>
</container>
