--TEST--
cms_image() renders each art-directed image as a <source> for its media query, before the image's own, in a <picture>, so a narrow screen gets the mobile image at its own aspect ratio
--TEMPLATE--
{{ cms_image(image, {layout: 'full_width', art_direction: [{media: '(max-width: 47.99rem)', image: mobile}]}) }}
--DATA--
return $this->rendering(['image' => $this->image(2400, 1600), 'mobile' => $this->mobileImage(800, 1000)])
--EXPECT--
<picture><source media="(max-width: 47.99rem)" srcset="/webp/320/summer-sale-mobile.jpg 320w, /webp/640/summer-sale-mobile.jpg 640w, /webp/800/summer-sale-mobile.jpg 800w" sizes="100vw" width="800" height="1000"><img src="/webp/2400/summer-sale.jpg" srcset="/webp/320/summer-sale.jpg 320w, /webp/640/summer-sale.jpg 640w, /webp/960/summer-sale.jpg 960w, /webp/1280/summer-sale.jpg 1280w, /webp/1600/summer-sale.jpg 1600w, /webp/1920/summer-sale.jpg 1920w, /webp/2400/summer-sale.jpg 2400w" sizes="100vw" width="2400" height="1600" alt="A beach at dawn" loading="lazy" decoding="async"></picture>
