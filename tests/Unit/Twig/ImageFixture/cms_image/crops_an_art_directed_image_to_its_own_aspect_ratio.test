--TEST--
cms_image() crops an art-directed image to the aspect ratio given with it, not the image's, around its focal point
--TEMPLATE--
{{ cms_image(image, {layout: 'full_width', aspect_ratio: 3, art_direction: [{media: '(max-width: 47.99rem)', image: mobile, aspect_ratio: 0.8}]}) }}
--DATA--
return $this->rendering(['image' => $this->image(2400, 1600), 'mobile' => $this->mobileImage(1000, 1000)])
--EXPECT--
<picture><source media="(max-width: 47.99rem)" srcset="/webp/320x400/summer-sale-mobile.jpg 320w, /webp/640x800/summer-sale-mobile.jpg 640w, /webp/800x1000/summer-sale-mobile.jpg 800w" sizes="100vw" width="800" height="1000"><img src="/webp/2400x800/summer-sale.jpg" srcset="/webp/320x107/summer-sale.jpg 320w, /webp/640x213/summer-sale.jpg 640w, /webp/960x320/summer-sale.jpg 960w, /webp/1280x427/summer-sale.jpg 1280w, /webp/1600x533/summer-sale.jpg 1600w, /webp/1920x640/summer-sale.jpg 1920w, /webp/2400x800/summer-sale.jpg 2400w" sizes="100vw" width="2400" height="800" alt="A beach at dawn" loading="lazy" decoding="async"></picture>
