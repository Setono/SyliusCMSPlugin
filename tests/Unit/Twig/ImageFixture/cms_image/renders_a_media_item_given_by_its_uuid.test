--TEST--
cms_image() renders a media item given by its UUID, in either case
--TEMPLATE--
{{ cms_image(uuid, {layout: 'fixed', width: 200}) }}
--DATA--
return $this->rendering(['uuid' => strtoupper($this->inTheLibrary($this->image()))])
--EXPECT--
<img src="/webp/200/summer-sale.jpg" srcset="/webp/200/summer-sale.jpg 1x, /webp/400/summer-sale.jpg 2x" width="200" height="133" alt="A beach at dawn" loading="lazy" decoding="async">
