--TEST--
cms_image() renders a fixed image at its width and twice it, with density descriptors and no sizes, and only at 1x when the source isn't twice as wide, at most as wide as the source
--TEMPLATE--
{{ cms_image(image, {layout: 'fixed', width: 200}) }}
{{ cms_image(small, {layout: 'fixed', width: 300}) }}
{{ cms_image(small, {layout: 'fixed', width: 500}) }}
--DATA--
return $this->rendering(['image' => $this->image(2400, 1600), 'small' => $this->image(400, 200)])
--EXPECT--
<img src="/webp/200/summer-sale.jpg" srcset="/webp/200/summer-sale.jpg 1x, /webp/400/summer-sale.jpg 2x" width="200" height="133" alt="A beach at dawn" loading="lazy" decoding="async">
<img src="/webp/300/summer-sale.jpg" srcset="/webp/300/summer-sale.jpg 1x" width="300" height="150" alt="A beach at dawn" loading="lazy" decoding="async">
<img src="/webp/400/summer-sale.jpg" srcset="/webp/400/summer-sale.jpg 1x" width="400" height="200" alt="A beach at dawn" loading="lazy" decoding="async">
