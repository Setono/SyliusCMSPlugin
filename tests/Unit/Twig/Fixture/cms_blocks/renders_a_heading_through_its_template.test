--TEST--
cms_blocks() renders a heading through its template, at the chosen level
--TEMPLATE--
{{ cms_blocks(blocks) }}
--DATA--
return $this->rendering(['blocks' => [$this->heading('Hello')]])
--EXPECT--
<h2 class="cms-heading">Hello</h2>
--DATA--
return $this->rendering(['blocks' => [$this->heading('Hello', 'h3')]])
--EXPECT--
<h3 class="cms-heading">Hello</h3>
