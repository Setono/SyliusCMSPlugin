--TEST--
cms_pagination() gives the page of the entry's paginated Entries block that shows, its entries and its links, each to the entry's URL with ?page=N, page 1 without it
--TEMPLATE--
{%- set pagination = cms_pagination(view) -%}
entries: {{ pagination.entries|join(", ") }}
links: {{ pagination.links|map(link => link.page ~ (link.current ? " (current)") ~ " " ~ link.url)|join(", ") }}
previous: {{ pagination.previous.url }}
next: {{ pagination.next.url }}
--DATA--
return $this->onPageOfTheBlog(2, items: 12, limit: 5)
--EXPECT--
entries: Post 6, Post 7, Post 8, Post 9, Post 10
links: 1 /en_US/blog, 2 (current) /en_US/blog?page=2, 3 /en_US/blog?page=3
previous: /en_US/blog
next: /en_US/blog?page=3
