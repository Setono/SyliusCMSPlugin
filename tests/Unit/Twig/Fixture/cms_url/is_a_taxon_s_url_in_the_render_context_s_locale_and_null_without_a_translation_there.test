--TEST--
cms_url() is the URL of a taxon's product listing, the one its link target gives, in the render context's locale, and null where it has no translation
--TEMPLATE--
{{ cms_url(taxon) }}|{{ cms_url(taxon) is null ? 'null' }}
--DATA--
return $this->rendering(['taxon' => $this->taxon(['en_US' => ['T-shirts', 't-shirts'], 'de_DE' => ['T-Shirts', 'kleidung/t-shirts']])], locale: 'de_DE')
--EXPECT--
/de_DE/taxons/kleidung/t-shirts|
--DATA--
return $this->rendering(['taxon' => $this->taxon(['en_US' => ['T-shirts', 't-shirts']])], locale: 'de_DE')
--EXPECT--
|null
