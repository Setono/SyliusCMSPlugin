--TEST--
cms_meta_title() gives the title, through the fallback chain, followed by the channel's name, as Sylius titles a product page, when no locale in the chain has a meta title
--TEMPLATE--
<title>{{ cms_meta_title(entry) }}</title>
--DATA--
return $this->rendering(
    ['entry' => $this->pageWith(['en_US' => ['title' => 'About us', 'slug' => 'about-us'], 'de_DE' => ['title' => 'Über uns', 'slug' => 'ueber-uns'], 'de_CH' => ['title' => '', 'slug' => 'ueber-uns']])],
    locale: 'de_CH',
    channel: $this->channel([], name: 'Fashion & Co'),
)
--EXPECT--
<title>Über uns | Fashion &amp; Co</title>
