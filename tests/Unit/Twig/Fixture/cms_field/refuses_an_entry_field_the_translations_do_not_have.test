--TEST--
cms_field() refuses to print an entry field its translations don't have
--TEMPLATE--
{{ cms_field(entry, "subtitle") }}
--DATA--
return $this->rendering(['entry' => $this->page(['en_US' => 'About us'])])
--EXCEPTION--
Twig\Error\RuntimeError: An exception has been thrown during the rendering of a template ("The translations of Setono\SyliusCMSPlugin\Model\Page have no field "subtitle"") in "index.twig" at line 2.
