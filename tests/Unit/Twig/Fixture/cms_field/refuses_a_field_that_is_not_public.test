--TEST--
cms_field() refuses to print a field that isn't public
--TEMPLATE--
{{ cms_field(object, "secret") }}
--DATA--
return $this->rendering(['object' => $this->notABlock()])
--EXCEPTION--
Twig\Error\RuntimeError: An exception has been thrown during the rendering of a template ("The field "secret" of Setono\SyliusCMSPlugin\Tests\Unit\Twig\Fixture\NotABlock must be a public property") in "index.twig" at line 2.
