--TEST--
cms_field() doesn't mark fields for shoppers or on share links
--TEMPLATE--
{{ cms_blocks(blocks) }}
--DATA--
return $this->rendering(['blocks' => [$this->heading('Hello')]])
--EXPECT--
<h2 class="cms-heading">Hello</h2>
--DATA--
return $this->rendering(['blocks' => [$this->heading('Hello')]], 'share')
--EXPECT--
<h2 class="cms-heading">Hello</h2>
