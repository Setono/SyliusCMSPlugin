--TEST--
cms_field() marks an empty field in the builder's preview
--TEMPLATE--
{{ cms_blocks(blocks) }}
--DATA--
return $this->rendering(['blocks' => [$this->heading(null)]], 'builder')
--EXPECT--
<h2 class="cms-heading"><!--cms:field 0193a5be-6f1c-7d2e-9b41-6a8f0c2d3e4f text text--><!--/cms:field 0193a5be-6f1c-7d2e-9b41-6a8f0c2d3e4f text--></h2>
