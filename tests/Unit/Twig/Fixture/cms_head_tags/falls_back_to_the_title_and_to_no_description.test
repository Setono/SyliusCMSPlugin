--TEST--
cms_head_tags() gives the title, through the fallback chain, when no locale in the chain has a meta title, and no description when none has one
--TEMPLATE--
{% set tags = cms_head_tags(entry) %}
{{ tags.title }}|{{ tags.description is null ? 'no description' : tags.description }}
--DATA--
return $this->rendering(['entry' => $this->pageWith(['en_US' => ['title' => 'About us', 'slug' => 'about-us'], 'de_DE' => ['title' => 'Über uns', 'slug' => 'ueber-uns'], 'de_CH' => ['title' => '', 'slug' => 'ueber-uns']])], locale: 'de_CH')
--EXPECT--
Über uns|no description
