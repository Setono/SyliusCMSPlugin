--TEST--
cms_head_tags() leaves out x-default when the entry doesn't show in the channel's default locale
--TEMPLATE--
{% for link in cms_head_tags(entry).alternates %}
{{ link.hreflang }} {{ link.url }}
{% endfor %}
--DATA--
return $this->rendering(
    ['entry' => $this->pageWith(['en_US' => ['title' => 'About us', 'slug' => 'about-us', 'shown' => false], 'da_DK' => ['title' => 'Om os', 'slug' => 'om-os']])],
    locale: 'da_DK',
    channel: $this->channel(['en_US', 'da_DK'], 'en_US'),
)
--EXPECT--
da-DK https://shop.example/da_DK/om-os
