{
    "name": "setono/sylius-cms-plugin",
    "description": "CMS plugin for your Sylius store",
    "license": "proprietary",
    "type": "sylius-plugin",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "doctrine/collections": "^1.6",
        "doctrine/dbal": "^2.13 || ^3.0",
        "doctrine/persistence": "^2.2 || ^3.0",
        "fakerphp/faker": "^1.21",
        "knplabs/gaufrette": "^0.8 || ^0.9 || 0.10 || ^0.11",
        "knplabs/knp-gaufrette-bundle": "^0.7 || ^0.8",
        "knplabs/knp-menu": "^3.3",
        "liip/imagine-bundle": "^2.6",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/composite-compiler-pass": "^1.1",
        "setono/editorjs-bundle": "^1.1",
        "setono/editorjs-php": "^1.2",
        "setono/twig-cache-purger-bundle": "^1.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "sylius/channel": "^1.0",
        "sylius/channel-bundle": "^1.0",
        "sylius/core": "^1.0",
        "sylius/core-bundle": "^1.0",
        "sylius/locale": "^1.0",
        "sylius/resource-bundle": "^1.8",
        "sylius/ui-bundle": "^1.8",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/event-dispatcher": "^5.4 || ^6.4 || ^7.0",
        "symfony/event-dispatcher-contracts": "^2.5 || ^3.1",
        "symfony/form": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/options-resolver": "^5.4 || ^6.4 || ^7.0",
        "symfony/property-access": "^5.4 || ^6.4 || ^7.0",
        "symfony/routing": "^5.4 || ^6.4 || ^7.0",
        "symfony/security-core": "^5.4 || ^6.4 || ^7.0",
        "symfony/uid": "^5.4 || ^6.4 || ^7.0",
        "twig/twig": "^2.15 || ^3.4",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "api-platform/core": "^2.7.16",
        "babdev/pagerfanta-bundle": "^3.8",
        "behat/behat": "^3.14",
        "doctrine/doctrine-bundle": "^2.11",
        "infection/infection": "^0.27.9",
        "jms/serializer-bundle": "^4.2",
        "lexik/jwt-authentication-bundle": "^2.17",
        "matthiasnoback/symfony-config-test": "^4.3 || ^5.1",
        "matthiasnoback/symfony-dependency-injection-test": "^4.3 || ^5.0",
        "phpspec/prophecy-phpunit": "^2.1",
        "phpunit/phpunit": "^9.6",
        "psalm/plugin-phpunit": "^0.18",
        "psalm/plugin-symfony": "^5.0",
        "setono/code-quality-pack": "^2.7",
        "sylius/sylius": "~1.12.13",
        "symfony/debug-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/dotenv": "^5.4 || ^6.4 || ^7.0",
        "symfony/intl": "^5.4 || ^6.4 || ^7.0",
        "symfony/property-info": "^5.4 || ^6.4 || ^7.0",
        "symfony/serializer": "^5.4 || ^6.4 || ^7.0",
        "symfony/web-profiler-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/webpack-encore-bundle": "^1.17",
        "weirdan/doctrine-psalm-plugin": "^2.9",
        "willdurand/negotiation": "^3.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusCMSPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\SyliusCMSPlugin\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "symfony/thanks": false
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "psalm",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "fixtures": "(cd tests/Application && bin/console sylius:fixtures:load default -n -vvv)",
        "phpunit": "phpunit"
    }
}
