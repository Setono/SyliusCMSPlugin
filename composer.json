{
    "name": "setono/sylius-cms-plugin",
    "description": "CMS plugin for your Sylius store",
    "license": "proprietary",
    "type": "sylius-plugin",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "doctrine/collections": "^1.6",
        "doctrine/dbal": "^2.13",
        "doctrine/persistence": "^2.2",
        "fakerphp/faker": "^1.20",
        "knplabs/gaufrette": "^0.8",
        "knplabs/knp-gaufrette-bundle": "^0.7",
        "knplabs/knp-menu": "^3.3",
        "liip/imagine-bundle": "^2.9",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/editorjs-bundle": "^0.2",
        "setono/editorjs-php": "^0.2.1",
        "setono/symfony-main-request-trait": "^1.0",
        "setono/twig-cache-purger-bundle": "^1.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "sylius/resource-bundle": "^1.6",
        "symfony/config": "^5.4 || ^6.0",
        "symfony/dependency-injection": "^5.4 || ^6.0",
        "symfony/doctrine-bridge": "^5.3 || ^6.0",
        "symfony/event-dispatcher": "^5.4 || ^6.0",
        "symfony/event-dispatcher-contracts": "^2.0 || ^3.0",
        "symfony/form": "^5.4 || ^6.0",
        "symfony/http-foundation": "^5.4 || ^6.0",
        "symfony/http-kernel": "^5.4 || ^6.0",
        "symfony/options-resolver": "^5.4 || ^6.0",
        "symfony/property-access": "^5.4 || ^6.0",
        "symfony/routing": "^5.4 || ^6.0",
        "symfony/security-core": "^5.4 || ^6.0",
        "symfony/uid": "^5.4 || ^6.0",
        "twig/twig": "^2.15",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "api-platform/core": "^2.7",
        "friendsofsymfony/oauth-server-bundle": ">2.0.0-alpha.0 ^2.0@dev",
        "lexik/jwt-authentication-bundle": "^2.16",
        "matthiasnoback/symfony-config-test": "^4.3",
        "matthiasnoback/symfony-dependency-injection-test": "^4.3",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpunit/phpunit": "^9.5",
        "psalm/plugin-phpunit": "^0.18",
        "psalm/plugin-symfony": "^4.0",
        "roave/security-advisories": "dev-latest",
        "setono/code-quality-pack": "^2.2",
        "sylius/admin-api-bundle": "1.11",
        "sylius/sylius": "~1.10.14",
        "symfony/debug-bundle": "^5.4 || ^6.0",
        "symfony/dotenv": "^5.4 || ^6.0",
        "symfony/intl": "^5.4 || ^6.0",
        "symfony/property-info": "^5.4 || ^6.0",
        "symfony/serializer": "^5.4 || ^6.0",
        "symfony/web-profiler-bundle": "^5.4 || ^6.0",
        "symfony/webpack-encore-bundle": "^1.16",
        "weirdan/doctrine-psalm-plugin": "^2.5"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusCMSPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Setono\\SyliusCMSPlugin\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "symfony/thanks": false
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": [
            "@ensure-test-container-exists",
            "psalm --threads=8"
        ],
        "check-style": "ecs check",
        "ensure-test-container-exists": "[[ -f tests/Application/var/cache/test/Tests_Setono_SyliusCMSPlugin_Application_KernelTestDebugContainer.xml ]] || tests/Application/bin/console cache:warmup --env=test",
        "fix-style": "ecs check --fix",
        "fixtures": "(cd tests/Application && bin/console sylius:fixtures:load default -n -vvv)",
        "phpunit": "phpunit"
    }
}
