{
  "name": "setono/sylius-cms-plugin",
  "description": "CMS plugin for your Sylius store",
  "license": "proprietary",
  "type": "sylius-plugin",
  "keywords": [
    "sylius",
    "sylius-plugin",
    "cms"
  ],
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "doctrine/orm": "^2.13",
    "doctrine/persistence": "^2.3 || ^3.0",
    "psr/clock": "^1.0",
    "psr/container": "^1.1 || ^2.0",
    "sylius/channel": "~1.14.0",
    "sylius/core": "~1.14.0",
    "sylius/core-bundle": "~1.14.0",
    "sylius/currency": "~1.14.0",
    "sylius/customer": "~1.14.0",
    "sylius/locale": "~1.14.0",
    "sylius/resource-bundle": "^1.12",
    "symfony/clock": "^6.4 || ^7.0",
    "symfony/config": "^6.4",
    "symfony/dependency-injection": "^6.4",
    "symfony/form": "^6.4",
    "symfony/http-foundation": "^6.4",
    "symfony/http-kernel": "^6.4",
    "symfony/options-resolver": "^6.4",
    "symfony/routing": "^6.4",
    "symfony/security-core": "^6.4",
    "symfony/security-csrf": "^6.4",
    "symfony/service-contracts": "^2.5 || ^3.0",
    "symfony/translation": "^6.4",
    "symfony/translation-contracts": "^2.5",
    "symfony/uid": "^6.4",
    "symfony/validator": "^6.4",
    "twig/twig": "^3.7.1"
  },
  "require-dev": {
    "api-platform/core": "^2.7.16",
    "babdev/pagerfanta-bundle": "^3.8",
    "dama/doctrine-test-bundle": "^7.3",
    "doctrine/doctrine-bundle": "^2.11",
    "jms/serializer-bundle": "^4.2",
    "lexik/jwt-authentication-bundle": "^2.17",
    "playwright-php/playwright-symfony": "^0.12",
    "setono/sylius-plugin-pack": "~1.14.1",
    "shipmonk/composer-dependency-analyser": "^1.6",
    "sylius-labs/polyfill-symfony-security": "^1.1.2",
    "symfony/browser-kit": "^6.4",
    "symfony/css-selector": "^6.4",
    "symfony/debug-bundle": "^6.4",
    "symfony/dotenv": "^6.4",
    "symfony/intl": "^6.4",
    "symfony/property-info": "^6.4",
    "symfony/serializer": "^6.4",
    "symfony/web-profiler-bundle": "^6.4",
    "symfony/webpack-encore-bundle": "^1.17.2",
    "willdurand/negotiation": "^3.1"
  },
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Setono\\SyliusCMSPlugin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Setono\\SyliusCMSPlugin\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/Application/Kernel.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true,
      "symfony/thanks": false
    },
    "audit": {
      "block-insecure": false
    },
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse",
    "check-style": "ecs check",
    "fix-style": "ecs check --fix",
    "phpunit": "phpunit"
  }
}
