{
    "name": "setono/sylius-cms-plugin",
    "type": "sylius-plugin",
    "description": "CMS plugin for your Sylius store",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "doctrine/collections": "^1.6",
        "doctrine/dbal": "^2.13",
        "fakerphp/faker": "^1.9",
        "knplabs/gaufrette": "^0.8",
        "knplabs/knp-gaufrette-bundle": "^0.7",
        "knplabs/knp-menu": "^3.2",
        "liip/imagine-bundle": "^2.6",
        "psr/log": "^1.1",
        "setono/editorjs-bundle": "^0.1.1",
        "setono/editorjs-php": "^0.1.2",
        "stof/doctrine-extensions-bundle": "^1.6",
        "sylius/resource-bundle": "^1.8",
        "symfony/config": "^5.0 || ^6.0",
        "symfony/dependency-injection": "^5.0 || ^6.0",
        "symfony/doctrine-bridge": "^5.0 || ^6.0",
        "symfony/event-dispatcher": "^5.0 || ^6.0",
        "symfony/event-dispatcher-contracts": "^2.0",
        "symfony/form": "^5.0 || ^6.0",
        "symfony/http-foundation": "^5.0 || ^6.0.7",
        "symfony/http-kernel": "^4.4 || ^5.1.5",
        "symfony/options-resolver": "^5.0 || ^6.0",
        "symfony/property-access": "^5.0 || ^6.0",
        "symfony/routing": "^5.0 || ^6.0",
        "symfony/security-core": "^5.0 || ^6.0",
        "twig/twig": "^2.14",
        "webmozart/assert": "^1.10"
    },
    "conflict": {
        "symfony/security-bundle": "5.4.0"
    },
    "require-dev": {
        "api-platform/core": "^2.6",
        "friendsofsymfony/oauth-server-bundle": ">2.0.0-alpha.0 ^2.0@dev",
        "lexik/jwt-authentication-bundle": "^2.14",
        "matthiasnoback/symfony-config-test": "^4.3",
        "matthiasnoback/symfony-dependency-injection-test": "^4.3",
        "phpunit/phpunit": "^9.5",
        "psalm/plugin-phpunit": "^0.16.1",
        "psalm/plugin-symfony": "^3.1",
        "roave/security-advisories": "dev-latest",
        "setono/code-quality-pack": "^2.1.3",
        "sylius/admin-api-bundle": "1.10.0-RC.2",
        "sylius/sylius": "~1.10.5",
        "symfony/debug-bundle": "^5.0 || ^6.0",
        "symfony/dotenv": "^5.0 || ^6.0",
        "symfony/intl": "^5.0 || ^6.0",
        "symfony/property-info": "^5.0 || ^6.0",
        "symfony/serializer": "^5.0 || ^6.0",
        "symfony/web-profiler-bundle": "^5.0 || ^6.0",
        "symfony/webpack-encore-bundle": "^1.13",
        "weirdan/doctrine-psalm-plugin": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Setono\\SyliusCMSPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Setono\\SyliusCMSPlugin\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "prefer-stable": true,
    "scripts": {
        "analyse": [
            "@ensure-test-container-exists",
            "psalm --threads=8"
        ],
        "check-style": "ecs check",
        "ensure-test-container-exists": "[[ -f tests/Application/var/cache/test/Tests_Setono_SyliusCMSPlugin_Application_KernelTestDebugContainer.xml ]] || tests/Application/bin/console cache:warmup --env=test",
        "fix-style": "ecs check --fix",
        "fixtures": "(cd tests/Application && bin/console sylius:fixtures:load default -n -vvv)",
        "phpunit": "phpunit"
    }
}
