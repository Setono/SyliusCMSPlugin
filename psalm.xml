<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    findUnusedPsalmSuppress="false"
    findUnusedCode="false"
    findUnusedVariablesAndParams="false"
    errorLevel="1"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="tests/Application"/>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>tests/Application/var/cache/test/Tests_Setono_SyliusCMSPlugin_Application_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
        <pluginClass class="Weirdan\DoctrinePsalmPlugin\Plugin"/>
    </plugins>
    <issueHandlers>
        <!-- We only use var annotations when PhpStorm doesn't understand types -->
        <UnnecessaryVarAnnotation errorLevel="suppress"/>
        <MissingTemplateParam>
            <errorLevel type="suppress">
                <directory name="src/Form/Type"/>
            </errorLevel>
        </MissingTemplateParam>
    </issueHandlers>
</psalm>
