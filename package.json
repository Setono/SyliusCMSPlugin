        "test": "vitest run"
    },
    "dependencies": {
        "@radix-ui/react-dropdown-menu": "2.1.25",
        "immer": "10.1.3",
        "react": "19.2.9",
        "react-dom": "19.2.9",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "22.20.5",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "@vitejs/plugin-react": "4.7.0",
        "jsdom": "26.1.0",
        "typescript": "5.9.3",
        "vite": "6.4.5",
        "vitest": "3.2.7"
    }
}
