{
    "name": "setono-sylius-cms-plugin-builder",
    "private": true,
    "description": "The builder app of setono/sylius-cms-plugin. Its compiled assets are committed to src/Resources/public/builder.",
    "license": "UNLICENSED",
    "type": "module",
    "engines": {
        "node": ">=20"
